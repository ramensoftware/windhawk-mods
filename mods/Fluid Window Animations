void SetDwmTransitions(HWND hWnd, BOOL enable) {
    BOOL disable = !enable;
    DwmSetWindowAttribute(hWnd, DWMWA_TRANSITIONS_FORCEDISABLED, &disable, sizeof(disable));
}

static inline float clampf(float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); }
static inline int max_int(int a, int b) { return a > b ? a : b; }
static inline int min_int(int a, int b) { return a < b ? a : b; }
static inline float easeOutCubic(float t) { float f = t - 1.0f; return f * f * f + 1.0f; }
static inline float easeInOutSine(float t) { return -0.5f * (cosf(PI * t) - 1.0f); }

static HBITMAP CreateArgbDib(HDC hRefDC, int w, int h, void** outBits) {
    BITMAPINFO bmi = {0};
    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
    bmi.bmiHeader.biWidth = w; bmi.bmiHeader.biHeight = -h;
    bmi.bmiHeader.biPlanes = 1; bmi.bmiHeader.biBitCount = 32; bmi.bmiHeader.biCompression = BI_RGB;
    return CreateDIBSection(hRefDC, &bmi, DIB_RGB_COLORS, outBits, NULL, 0);
}

static void RevealRealWindow(GhostAnimData* data) {
    if (data->isRising) {
        SetLayeredWindowAttributes(data->hRealWnd, 0, 255, LWA_ALPHA);
        RedrawWindow(data->hRealWnd, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_FRAME | RDW_UPDATENOW);
        if (!(data->originalExStyle & WS_EX_LAYERED)) {
            SetWindowLongPtrW(data->hRealWnd, GWL_EXSTYLE, data->originalExStyle);
            SetWindowPos(data->hRealWnd, NULL, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_FRAMECHANGED | SWP_NOACTIVATE);
        }
        DwmFlush();
        Sleep(15);
    } else {
        SetLayeredWindowAttributes(data->hRealWnd, 0, 0, LWA_ALPHA);
    }
    SetDwmTransitions(data->hRealWnd, TRUE);
}

// --- Shrink to icon (former Vanilla) ---
static void RunShrinkToIcon(GhostAnimData* data) {
    int screenW = GetSystemMetrics(SM_CXSCREEN);
    int screenH = GetSystemMetrics(SM_CYSCREEN);

    RECT r = data->targetRect;
    int w = data->width, h = data->height;
    float dockX = (float)data->targetDockX;
    float dockY = (float)data->targetDockY;

    HDC hScreenDC = GetDC(NULL);
    HDC hSrcDC = CreateCompatibleDC(hScreenDC);
    HBITMAP hOldSrc = (HBITMAP)SelectObject(hSrcDC, data->hBitmap);
    void* workBits = NULL;
    HBITMAP hWork = CreateArgbDib(hScreenDC, screenW, screenH, &workBits);
    HDC hWorkDC = CreateCompatibleDC(hScreenDC);
    HBITMAP hOldWork = (HBITMAP)SelectObject(hWorkDC, hWork);
    HWND hGhost = CreateWindowExW(WS_EX_LAYERED | WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_TRANSPARENT,
                                  L"STATIC", NULL, WS_POPUP, 0, 0, screenW, screenH, NULL, NULL, NULL, NULL);
    SetStretchBltMode(hWorkDC, COLORONCOLOR);

    LARGE_INTEGER freq, start, now;
    QueryPerformanceFrequency(&freq); QueryPerformanceCounter(&start);

    BOOL firstFrame = TRUE;
    double animDur = data->durationMs;
    double bounceDur = (data->isRising && data->bounceOnRestore) ? data->bounceDurationMs : 0;
    double totalDur = animDur + bounceDur;

    float iconTarget = clampf((float)g_minimizeIconSize.load(), 8.0f, 4096.0f);
    float iconW = iconTarget;
    float iconH = iconTarget;

    float targetX = dockX - iconW / 2.0f;
    float targetY = dockY - iconH / 2.0f;
    float startX = (float)r.left;
    float startY = (float)r.top;
    float startW = (float)w;
    float startH = (float)h;

    for (;;) {
        QueryPerformanceCounter(&now);
        
        double elapsed = 0.0;
        if (!firstFrame) {
            elapsed = (now.QuadPart - start.QuadPart) * 1000.0 / freq.QuadPart;
        }

        memset(workBits, 0, (size_t)screenW * screenH * 4);
        BYTE alpha = 255;

        if (elapsed <= animDur || !data->isRising) {
            float progress = clampf((float)(elapsed / animDur), 0.0f, 1.0f);
            float t = data->isRising ? (1.0f - progress) : progress; 
            
            float uX = 1.0f - t;
            float easeX = 1.0f - (uX * uX * uX * uX); // Faster curve for width (easeOutQuart)
            float uY = 1.0f - t;
            float easeY = 1.0f - (uY * uY * uY);      // Slower curve for height (easeOutCubic)

            int currentX = (int)(startX + (targetX - startX) * easeX);
            int currentY = (int)(startY + (targetY - startY) * easeY);
            int currentW = max_int(2, (int)(startW + (iconW - startW) * easeX));
            int currentH = max_int(2, (int)(startH + (iconH - startH) * easeY));

            StretchBlt(hWorkDC, currentX, currentY, currentW, currentH, hSrcDC, 0, 0, w, h, SRCCOPY);

            float fadeStart = clampf(g_vanillaFadeStart.load() / 100.0f, 0.0f, 0.95f);
            float fadeT = clampf((t - fadeStart) / (1.0f - fadeStart), 0.0f, 1.0f);
            alpha = (BYTE)clampf(255.0f * (1.0f - fadeT), 0.0f, 255.0f);
        } else {
            float tB = clampf((float)((elapsed - animDur) / bounceDur), 0.0f, 1.0f);
            float amp = data->bounceStrength / 100.0f * 0.16f;
            float scale = 1.0f + amp * sinf(tB * PI);
            
            int currentW = max_int(2, (int)(startW * scale));
            int currentH = max_int(2, (int)(startH * scale));
            int currentX = (int)(startX + startW / 2.0f - currentW / 2.0f);
            int currentY = (int)(startY + startH / 2.0f - currentH / 2.0f);
            
            StretchBlt(hWorkDC, currentX, currentY, currentW, currentH, hSrcDC, 0, 0, w, h, SRCCOPY);
            alpha = 255;
        }

        BLENDFUNCTION bf = { AC_SRC_OVER, 0, alpha, AC_SRC_ALPHA };
        POINT ptDst = { 0, 0 }; SIZE sz = { screenW, screenH };
        POINT ptSrc = { 0, 0 };
        UpdateLayeredWindow(hGhost, NULL, &ptDst, &sz, hWorkDC, &ptSrc, 0, &bf, ULW_ALPHA);
        
        if (firstFrame) {
            ShowWindow(hGhost, SW_SHOWNOACTIVATE);
            if (data->pReadyFlag) data->pReadyFlag->store(true);
            firstFrame = FALSE;
            QueryPerformanceCounter(&start);
        }
        if (elapsed >= totalDur && !firstFrame) break;
        DwmFlush();
    }

    RevealRealWindow(data);

    SelectObject(hWorkDC, hOldWork); SelectObject(hSrcDC, hOldSrc);
    DeleteObject(hWork); DeleteDC(hWorkDC); DeleteDC(hSrcDC); ReleaseDC(NULL, hScreenDC);
    DestroyWindow(hGhost);
}

// --- Seamless Unified CRT ---
static void RunCRT(GhostAnimData* data) {
    int startX = data->targetRect.left;
    int startY = data->targetRect.top;
    int startW = data->width; int startH = data->height;
    
    int cx = startX + startW / 2;
    int cy = startY + startH / 2;

    HDC hScreenDC = GetDC(NULL); HDC hSrcDC = CreateCompatibleDC(hScreenDC);
    HBITMAP hOldSrc = (HBITMAP)SelectObject(hSrcDC, data->hBitmap);
    
    int screenW = GetSystemMetrics(SM_CXSCREEN); int screenH = GetSystemMetrics(SM_CYSCREEN);
    void* workBits = NULL;
    HBITMAP hWork = CreateArgbDib(hScreenDC, screenW, screenH, &workBits);
    HDC hWorkDC = CreateCompatibleDC(hScreenDC); HBITMAP hOldWork = (HBITMAP)SelectObject(hWorkDC, hWork);
    HWND hGhost = CreateWindowExW(WS_EX_LAYERED | WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_TRANSPARENT,
                                  L"STATIC", NULL, WS_POPUP, 0, 0, screenW, screenH, NULL, NULL, NULL, NULL);

    LARGE_INTEGER freq, start, now; QueryPerformanceFrequency(&freq); QueryPerformanceCounter(&start);

    BOOL firstFrame = TRUE; 
    double animDur = data->durationMs;
    double bounceDur = (data->isRising && data->bounceOnRestore) ? data->bounceDurationMs : 0;
    double totalDur = animDur + bounceDur;

    for (;;) {
        QueryPerformanceCounter(&now);
        double elapsed = (now.QuadPart - start.QuadPart) * 1000.0 / freq.QuadPart;
        
        memset(workBits, 0, (size_t)screenW * screenH * 4);
        BYTE alpha = 255;
        
        if (elapsed <= animDur || !data->isRising) {
            float progress = clampf((float)(elapsed / animDur), 0.0f, 1.0f);
            float t = data->isRising ? (1.0f - progress) : progress;
            int curW = startW, curH = startH, curX = startX, curY = startY;
            
            if (t < 0.5f) {
                float easeY = easeOutCubic(t * 2.0f);
                curH = startH - (int)((startH - 2) * easeY); curY = startY + (startH / 2) - (curH / 2);
            } else {
                float easeX = easeOutCubic((t - 0.5f) * 2.0f);
                curH = 2; curY = startY + (startH / 2) - 1;
                curW = startW - (int)(startW * easeX);
                curX = startX + (startW / 2) - (curW / 2);
                alpha = (BYTE)(255 * (1.0f - easeX));
            }
            if (curW < 2) curW = 2;
            if (curH < 2) curH = 2;

            SetStretchBltMode(hWorkDC, COLORONCOLOR);
            StretchBlt(hWorkDC, curX, curY, curW, curH, hSrcDC, 0, 0, startW, startH, SRCCOPY);
        } else {
            float tB = clampf((float)((elapsed - animDur) / bounceDur), 0.0f, 1.0f);
            float amp = data->bounceStrength / 100.0f * 0.16f;
            float scale = 1.0f + amp * sinf(tB * PI);
            int newW = max_int(2, (int)(startW * scale));
            int newH = max_int(2, (int)(startH * scale));
            int destX = cx - newW / 2;
            int destY = cy - newH / 2;

            SetStretchBltMode(hWorkDC, COLORONCOLOR);
            StretchBlt(hWorkDC, destX, destY, newW, newH, hSrcDC, 0, 0, startW, startH, SRCCOPY);
        }

        BLENDFUNCTION bf = { AC_SRC_OVER, 0, alpha, AC_SRC_ALPHA };
        POINT ptDst = { 0, 0 }; SIZE sz = { screenW, screenH };
        POINT ptSrc = { 0, 0 };
        UpdateLayeredWindow(hGhost, NULL, &ptDst, &sz, hWorkDC, &ptSrc, 0, &bf, ULW_ALPHA);
        
        if (firstFrame) { 
            ShowWindow(hGhost, SW_SHOWNOACTIVATE); 
            if (data->pReadyFlag) data->pReadyFlag->store(true);
            firstFrame = FALSE; 
        }
        if (elapsed >= totalDur) break;
        DwmFlush();
    }

    RevealRealWindow(data);

    SelectObject(hWorkDC, hOldWork); SelectObject(hSrcDC, hOldSrc);
    DeleteObject(hWork); DeleteDC(hWorkDC); DeleteDC(hSrcDC); ReleaseDC(NULL, hScreenDC); 
    DestroyWindow(hGhost);
}

// --- Seamless Unified Genie ---
static void RunGenie(GhostAnimData* data) {
    int screenW = GetSystemMetrics(SM_CXSCREEN);
    int screenH = GetSystemMetrics(SM_CYSCREEN);
    float dockY = (float)data->targetDockY; float dockX = (float)data->targetDockX;

    RECT r = data->targetRect;
    int w = data->width, h = data->height;
    float top = (float)r.top; float startCenterX = (float)(r.left + w / 2);
    int bboxLeft = 0; int bboxRight = screenW; int bboxTop = max_int(0, r.top - (int)(h * 0.3f));
    int bboxW = bboxRight - bboxLeft; int bboxH = screenH - bboxTop;

    int SS = (int)clampf((float)g_genieQuality.load(), 1.0f, 3.0f);
    int rW = bboxW * SS, rH = bboxH * SS;

    float tailW = clampf((float)g_genieTailWidth.load(), 2.0f, (float)w);
    float tailFlat = clampf(tailW * 1.5f, 8.0f, 80.0f);
    float neckLen = clampf((float)(w - tailW) * 1.2f, (float)h * 0.2f, (float)screenH * 0.85f);

    HDC hScreenDC = GetDC(NULL); HDC hSrcDC = CreateCompatibleDC(hScreenDC);
    HBITMAP hOldSrc = (HBITMAP)SelectObject(hSrcDC, data->hBitmap);

    void* workBits = NULL; HBITMAP hWork = CreateArgbDib(hScreenDC, bboxW, bboxH, &workBits);
    HDC hWorkDC = CreateCompatibleDC(hScreenDC);
    HBITMAP hOldWork = (HBITMAP)SelectObject(hWorkDC, hWork);

    void* renderBits = workBits; HBITMAP hRender = NULL; HDC hRenderDC = hWorkDC;
    HBITMAP hOldRender = NULL;
    if (SS > 1) {
        hRender = CreateArgbDib(hScreenDC, rW, rH, &renderBits);
        hRenderDC = CreateCompatibleDC(hScreenDC);
        hOldRender = (HBITMAP)SelectObject(hRenderDC, hRender);
    }
    SetStretchBltMode(hRenderDC, COLORONCOLOR);

    HWND hGhost = CreateWindowExW(WS_EX_LAYERED | WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_TRANSPARENT,
                                  L"STATIC", NULL, WS_POPUP, bboxLeft, bboxTop, bboxW, bboxH, NULL, NULL, NULL, NULL);

    int N = (int)clampf((float)h / 2.0f, 80.0f, 450.0f);

    LARGE_INTEGER freq, start, now; QueryPerformanceFrequency(&freq); QueryPerformanceCounter(&start);

    BOOL firstFrame = TRUE;
    double animDur = data->durationMs;
    double bounceDur = (data->isRising && data->bounceOnRestore) ? data->bounceDurationMs : 0;
    double totalDur = animDur + bounceDur;

    float minTailOp = clampf(g_genieTailOpacity.load() / 100.0f, 0.0f, 1.0f);
    float tailFrac = clampf(g_genieTailLength.load() / 100.0f, 0.01f, 1.0f);

    for (;;) {
        QueryPerformanceCounter(&now);
        double elapsed = (now.QuadPart - start.QuadPart) * 1000.0 / freq.QuadPart;

        float flightP = clampf((float)(elapsed / animDur), 0.0f, 1.0f);
        float tFade = data->isRising ? (1.0f - flightP) : flightP;
        BYTE ca = (tFade > 0.90f) ? (BYTE)(255 * (1.0f - (tFade - 0.90f) / 0.10f)) : 255; 
        
        float geEase;
        if (data->isRising) {
            geEase = 1.0f - easeOutCubic(flightP);
        } else {
            geEase = easeOutCubic(flightP);
        }

        float logicalTop = top + (dockY - top) * geEase;
        float logicalBottom = (top + h) + (dockY - (top + h)) * geEase;
        float logicalH = max_int(1, (int)(logicalBottom - logicalTop));
        float centerY = logicalTop + logicalH / 2.0f;

        float bounceScaleX = 1.0f;
        float bounceScaleY = 1.0f;
        if (data->isRising && data->bounceOnRestore) {
            float bounceStart = animDur * 0.65f; 
            if (elapsed > bounceStart) {
                float realBounceDur = totalDur - bounceStart;
                float tB = clampf((float)((elapsed - bounceStart) / realBounceDur), 0.0f, 1.0f);
                float amp = data->bounceStrength / 100.0f * 0.16f;
                float bScale = 1.0f + amp * sinf(tB * PI);
                bounceScaleX = bScale;
                bounceScaleY = bScale;
            }
        }

        float currentH_f = logicalH * bounceScaleY;
        float currentTop = centerY - currentH_f / 2.0f;
        float currentBottom = centerY + currentH_f / 2.0f;
        float currentW = w * bounceScaleX;
        int currentH = max_int(1, (int)(currentH_f + 0.5f));

        float morphU = powf(1.0f - geEase, 6.0f);
        bool isFullRect = (geEase == 0.0f); 

        int bandTop = max_int(0, (int)currentTop - bboxTop - 2);
        int bandBot = min_int(bboxH, (int)currentBottom - bboxTop + 2);
        
        int marginX = w / 8 + 2;
        int spanL = max_int(0, min_int(r.left, (int)dockX) - bboxLeft - marginX);
        int spanR = min_int(bboxW, max_int(r.right, (int)dockX) - bboxLeft + marginX);
        if (spanR < spanL) spanR = spanL;

        memset(workBits, 0, (size_t)bboxW * bboxH * 4);
        if (SS > 1 && bandBot > bandTop) {
            int rTop = bandTop * SS, rBot = bandBot * SS;
            int rL = spanL * SS, rR = spanR * SS;
            size_t rowBytes = (size_t)(rR - rL) * 4;
            if (rowBytes > 0) {
                for (int ry = rTop; ry < rBot; ry++)
                    memset((BYTE*)renderBits + ((size_t)ry * rW + rL) * 4, 0, rowBytes);
            }
        }

        if (isFullRect) {
            int destX = (int)(((startCenterX - currentW / 2.0f) - bboxLeft) * SS + 0.5f);
            int destY = (int)(((currentTop) - bboxTop) * SS + 0.5f);
            int destW = (int)(currentW * SS + 0.5f);
            int destH = (int)(currentH * SS + 0.5f);
            StretchBlt(hRenderDC, destX, destY, destW, destH, hSrcDC, 0, 0, w, h, SRCCOPY);
        } else {
            for (int i = 0; i < N; i++) {
                float v0 = (float)i / N;
                float v1 = (float)(i + 1) / N;
                float y0 = currentTop + v0 * currentH_f;
                float y1 = currentTop + v1 * currentH_f;

                float dist = dockY - y0;
                float c0;
                if (dist <= tailFlat) c0 = 0.0f;
                else c0 = easeInOutSine(clampf((dist - tailFlat) / neckLen, 0.0f, 1.0f));

                float cEff = c0 + (1.0f - c0) * morphU;
                float rw0 = tailW + (currentW - tailW) * cEff;
                float cx0 = dockX + (startCenterX - dockX) * cEff;

                int destX = (int)(((cx0 - rw0 / 2.0f) - bboxLeft) * SS + 0.5f);
                int destY = (int)(((y0 - bboxTop) * SS) + 0.5f);
                int nextY = (int)(((y1 - bboxTop) * SS) + 0.5f);
                int destH = max_int(1, nextY - destY + 1);
                int destW = max_int(1, (int)(rw0 * SS + 0.5f));

                if (destY + destH <= 0 || destY >= rH) continue;

                int srcY = (int)(v0 * h + 0.5f);
                int nextSrcY = (int)(v1 * h + 0.5f);
                int srcH = max_int(1, nextSrcY - srcY);

                StretchBlt(hRenderDC, destX, destY, destW, destH, hSrcDC, 0, srcY, w, srcH, SRCCOPY);
            }
        }

        GdiFlush(); 

        if (SS == 2) {
            for (int y = bandTop; y < bandBot; y++) {
                uint32_t* s0 = (uint32_t*)((BYTE*)renderBits + (size_t)(y * 2)     * rW * 4);
                uint32_t* s1 = (uint32_t*)((BYTE*)renderBits + (size_t)(y * 2 + 1) * rW * 4);
                uint32_t* d  = (uint32_t*)((BYTE*)workBits   + (size_t)y           * bboxW * 4);
                for (int x = spanL; x < spanR; x++) {
                    int xx = x * 2;
                    uint32_t r0 = ((s0[xx] & 0xFEFEFEFEu) >> 1) + ((s0[xx + 1] & 0xFEFEFEFEu) >> 1);
                    uint32_t r1 = ((s1[xx] & 0xFEFEFEFEu) >> 1) + ((s1[xx + 1] & 0xFEFEFEFEu) >> 1);
                    d[x] = ((r0 & 0xFEFEFEFEu) >> 1) + ((r1 & 0xFEFEFEFEu) >> 1);
                }
            }
        } else if (SS > 1) {
            int n = SS * SS;
            for (int y = bandTop; y < bandBot; y++) {
                BYTE* drow = (BYTE*)workBits + (size_t)y * bboxW * 4;
                for (int x = spanL; x < spanR; x++) {
                    int sB = 0, sG = 0, sR = 0, sA = 0;
                    for (int sy = 0; sy < SS; sy++) {
                        BYTE* sp = (BYTE*)renderBits + ((size_t)(y * SS + sy) * rW + (size_t)(x * SS)) * 4;
                        for (int sx = 0; sx < SS; sx++) { sB += sp[0]; sG += sp[1]; sR += sp[2]; sA += sp[3]; sp += 4; }
                    }
                    BYTE* dp = drow + (size_t)x * 4;
                    dp[0] = (BYTE)(sB / n); dp[1] = (BYTE)(sG / n); dp[2] = (BYTE)(sR / n); dp[3] = (BYTE)(sA / n);
                }
            }
        }

        if (!isFullRect && minTailOp < 0.999f) {
            float bodyH = currentBottom - currentTop + 0.1f;
            int yStart = max_int(bandTop, max_int(0, (int)currentTop - bboxTop));
            int yEnd = min_int(bandBot, min_int(bboxH, (int)currentBottom - bboxTop + 1));
            
            BYTE* base = (BYTE*)workBits;
            
            for (int row = yStart; row < yEnd; row++) {
                int screenY = row + bboxTop;
                float f = clampf((screenY - currentTop) / bodyH, 0.0f, 1.0f);
                float ramp = clampf((1.0f - f) / tailFrac, 0.0f, 1.0f);
                float op = minTailOp + (1.0f - minTailOp) * ramp;
                
                op = op + (1.0f - op) * morphU; 
                
                if (op >= 0.999f) continue;
                BYTE* px = base + (size_t)row * bboxW * 4 + (size_t)spanL * 4;
                for (int x = spanL; x < spanR; x++) {
                    if (px[3]) {
                        px[0] = (BYTE)(px[0] * op); px[1] = (BYTE)(px[1] * op);
                        px[2] = (BYTE)(px[2] * op); px[3] = (BYTE)(px[3] * op);
                    }
                    px += 4;
                }
            }
        }

        BLENDFUNCTION bf = { AC_SRC_OVER, 0, ca, AC_SRC_ALPHA };
        POINT ptDst = { bboxLeft, bboxTop }; SIZE sz = { bboxW, bboxH };
        POINT ptSrc = { 0, 0 };
        UpdateLayeredWindow(hGhost, NULL, &ptDst, &sz, hWorkDC, &ptSrc, 0, &bf, ULW_ALPHA);
        
        if (firstFrame) {
            ShowWindow(hGhost, SW_SHOWNOACTIVATE);
            if (data->pReadyFlag) data->pReadyFlag->store(true);
            firstFrame = FALSE;
        }
        if (elapsed >= totalDur) break;
        DwmFlush();
    }

    RevealRealWindow(data);

    if (hRender) { SelectObject(hRenderDC, hOldRender); DeleteObject(hRender); DeleteDC(hRenderDC); }
    SelectObject(hWorkDC, hOldWork); SelectObject(hSrcDC, hOldSrc);
    DeleteObject(hWork); DeleteDC(hWorkDC); DeleteDC(hSrcDC); ReleaseDC(NULL, hScreenDC);
    DestroyWindow(hGhost);
}

DWORD WINAPI GhostAnimationThread(LPVOID lpParam) {
    GhostAnimData* data = (GhostAnimData*)lpParam;
    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
    if (data->mode == MODE_CRT) RunCRT(data);
    else if (data->mode == MODE_VANILLA) RunShrinkToIcon(data);
    else RunGenie(data);

    DeleteObject(data->hBitmap); 
    if (data->pReadyFlag) delete data->pReadyFlag; 
    delete data;
    g_activeAnims.fetch_sub(1, std::memory_order_relaxed);
    return 0;
}

void StartGenieAnim(HWND hWnd, BOOL rising) {
    RECT logRect, visRect;
    GetWindowRect(hWnd, &logRect);
    if (FAILED(DwmGetWindowAttribute(hWnd, DWMWA_EXTENDED_FRAME_BOUNDS, &visRect, sizeof(visRect)))) {
        visRect = logRect;
    }

    int w = visRect.right - visRect.left; 
    int h = visRect.bottom - visRect.top;
    if (w <= 0 || h <= 0) return;

    int offsetX = visRect.left - logRect.left;
    int offsetY = visRect.top - logRect.top;

    POINT pt; GetCursorPos(&pt); HWND hTaskbar = FindWindowW(L"Shell_TrayWnd", NULL);
    RECT tb = {0};
    BOOL curOnTb = (hTaskbar && GetWindowRect(hTaskbar, &tb) && PtInRect(&tb, pt));
    int learnedX = pt.x, learnedY = tb.bottom > 0 ? tb.top + (tb.bottom - tb.top)/2 : GetSystemMetrics(SM_CYSCREEN);
    
    if (curOnTb) {
        std::lock_guard<std::mutex> lock(g_CacheMutex); g_IconPositionsX[hWnd] = pt.x; g_IconPositionsY[hWnd] = learnedY;
    } else {
        std::lock_guard<std::mutex> lock(g_CacheMutex);
        if (g_IconPositionsX.count(hWnd)) { learnedX = g_IconPositionsX[hWnd]; learnedY = g_IconPositionsY[hWnd]; }
        else {
            HMONITOR hMon = MonitorFromWindow(hWnd, MONITOR_DEFAULTTONEAREST);
            MONITORINFO mi = { sizeof(mi) };
            if (GetMonitorInfo(hMon, &mi)) { learnedX = mi.rcWork.left + (mi.rcWork.right - mi.rcWork.left) / 2; learnedY = mi.rcWork.bottom; }
            else learnedX = GetSystemMetrics(SM_CXSCREEN) / 2;
        }
    }

    std::atomic<bool>* pReady = new std::atomic<bool>(false);

    GhostAnimData* data = new GhostAnimData();
    data->hRealWnd = hWnd; data->targetRect = visRect; data->width = w; data->height = h; data->isRising = rising;
    data->targetDockX = learnedX; data->targetDockY = learnedY; data->originalExStyle = GetWindowLongPtrW(hWnd, GWL_EXSTYLE);
    data->mode = g_mode.load(); data->durationMs = rising ? g_restoreMs.load() : g_minimizeMs.load();
    data->bounceOnRestore = g_bounceOnRestore.load();
    data->bounceStrength = g_bounceStrength.load(); 
    data->bounceDurationMs = g_bounceDurationMs.load(); data->pReadyFlag = pReady;

    HDC hScreenDC = GetDC(NULL); HDC hMemDC = CreateCompatibleDC(hScreenDC);
    void* bits = NULL;
    data->hBitmap = CreateArgbDib(hScreenDC, w, h, &bits); HBITMAP hOldBmp = (HBITMAP)SelectObject(hMemDC, data->hBitmap);
    
    if (rising) {
        BOOL fromCache = FALSE;
        {
            std::lock_guard<std::mutex> lock(g_CacheMutex);
            if (g_SnapshotCache.count(hWnd)) {
                HDC hCacheDC = CreateCompatibleDC(hScreenDC);
                HBITMAP hOldCacheBmp = (HBITMAP)SelectObject(hCacheDC, g_SnapshotCache[hWnd]);
                BitBlt(hMemDC, 0, 0, w, h, hCacheDC, 0, 0, SRCCOPY); SelectObject(hCacheDC, hOldCacheBmp); DeleteDC(hCacheDC);
                DeleteObject(g_SnapshotCache[hWnd]); g_SnapshotCache.erase(hWnd);
                fromCache = TRUE;
            }
        }
        if (!fromCache) {
            RedrawWindow(hWnd, NULL, NULL, RDW_ERASE | RDW_INVALIDATE | RDW_FRAME | RDW_UPDATENOW);
            SetWindowOrgEx(hMemDC, offsetX, offsetY, NULL);
            PrintWindow(hWnd, hMemDC, PW_CLIENTONLY | 0x00000002);
            SetWindowOrgEx(hMemDC, 0, 0, NULL);
        }
    } else {
        BitBlt(hMemDC, 0, 0, w, h, hScreenDC, visRect.left, visRect.top, SRCCOPY);
        std::lock_guard<std::mutex> lock(g_CacheMutex);
        if (g_SnapshotCache.count(hWnd)) DeleteObject(g_SnapshotCache[hWnd]);
        g_SnapshotCache[hWnd] = CreateCompatibleBitmap(hScreenDC, w, h);
        HDC hCacheDC = CreateCompatibleDC(hScreenDC); HBITMAP hOldCacheBmp = (HBITMAP)SelectObject(hCacheDC, g_SnapshotCache[hWnd]);
        BitBlt(hCacheDC, 0, 0, w, h, hMemDC, 0, 0, SRCCOPY); SelectObject(hCacheDC, hOldCacheBmp); DeleteDC(hCacheDC);
    }

    GdiFlush(); SelectObject(hMemDC, hOldBmp); DeleteDC(hMemDC);
    ReleaseDC(NULL, hScreenDC);

    g_activeAnims.fetch_add(1, std::memory_order_relaxed);
    HANDLE hThread = CreateThread(NULL, 0, GhostAnimationThread, data, 0, NULL);
    if (hThread) {
        if (!rising) {
            int timeout = 15;
            while (!pReady->load() && timeout > 0) { Sleep(10); timeout--; }
            
            // Hide the real window for ALL modes ONLY after the first frame
            LONG_PTR exStyle = GetWindowLongPtrW(hWnd, GWL_EXSTYLE);
            SetWindowLongPtrW(hWnd, GWL_EXSTYLE, exStyle | WS_EX_LAYERED);
            SetLayeredWindowAttributes(hWnd, 0, 0, LWA_ALPHA);
        }
        CloseHandle(hThread);
    } else {
        DeleteObject(data->hBitmap); delete pReady; delete data;
        g_activeAnims.fetch_sub(1, std::memory_order_relaxed);
    }
}

BOOL WINAPI ShowWindow_Hook(HWND hWnd, int nCmdShow) {
    if (nCmdShow == SW_MINIMIZE || nCmdShow == SW_SHOWMINIMIZED || nCmdShow == SW_SHOWMINNOACTIVE) {
        SetDwmTransitions(hWnd, FALSE);
        StartGenieAnim(hWnd, FALSE);
        return ShowWindow_Original(hWnd, nCmdShow);
    } else if (nCmdShow == SW_RESTORE || nCmdShow == SW_SHOWNORMAL) {
        if (IsIconic(hWnd)) {
            SetDwmTransitions(hWnd, FALSE);
            SetWindowLongPtrW(hWnd, GWL_EXSTYLE, GetWindowLongPtrW(hWnd, GWL_EXSTYLE) | WS_EX_LAYERED);
            SetLayeredWindowAttributes(hWnd, 0, 0, LWA_ALPHA);
            BOOL res = ShowWindow_Original(hWnd, nCmdShow); StartGenieAnim(hWnd, TRUE); return res;
        }
    }
    return ShowWindow_Original(hWnd, nCmdShow);
}

LRESULT WINAPI DefWindowProcW_Hook(HWND hWnd, UINT Msg, WPARAM wParam, LPARAM lParam) {
    if (Msg == WM_DESTROY) {
        std::lock_guard<std::mutex> lock(g_CacheMutex);
        if (g_SnapshotCache.count(hWnd)) { DeleteObject(g_SnapshotCache[hWnd]); g_SnapshotCache.erase(hWnd); }
        g_IconPositionsX.erase(hWnd); g_IconPositionsY.erase(hWnd);
    }
    if (Msg == WM_SYSCOMMAND) {
        UINT cmd = wParam & 0xFFF0;
        if (cmd == SC_MINIMIZE) {
            SetDwmTransitions(hWnd, FALSE); StartGenieAnim(hWnd, FALSE);
            return DefWindowProcW_Original(hWnd, Msg, wParam, lParam);
        } else if (cmd == SC_RESTORE && IsIconic(hWnd)) {
            SetDwmTransitions(hWnd, FALSE);
            SetWindowLongPtrW(hWnd, GWL_EXSTYLE, GetWindowLongPtrW(hWnd, GWL_EXSTYLE) | WS_EX_LAYERED);
            SetLayeredWindowAttributes(hWnd, 0, 0, LWA_ALPHA);
            LRESULT res = DefWindowProcW_Original(hWnd, Msg, wParam, lParam); StartGenieAnim(hWnd, TRUE);
            return res;
        }
    }
    return DefWindowProcW_Original(hWnd, Msg, wParam, lParam);
}

BOOL Wh_ModInit() {
    LoadSettings();
    Wh_SetFunctionHook((void*)DefWindowProcW, (void*)DefWindowProcW_Hook, (void**)&DefWindowProcW_Original);
    Wh_SetFunctionHook((void*)ShowWindow, (void*)ShowWindow_Hook, (void**)&ShowWindow_Original);
    return TRUE;
}

void Wh_ModSettingsChanged() { LoadSettings(); }

void Wh_ModUninit() {
    int spins = 200;
    while (g_activeAnims.load(std::memory_order_relaxed) > 0 && spins-- > 0) Sleep(10);
    std::lock_guard<std::mutex> lock(g_CacheMutex);
    for (auto& pair : g_SnapshotCache) DeleteObject(pair.second);
    g_SnapshotCache.clear(); g_IconPositionsX.clear(); g_IconPositionsY.clear();
}
