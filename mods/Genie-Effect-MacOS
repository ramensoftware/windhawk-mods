struct GhostAnimData {
    HWND         hRealWnd;
    HBITMAP      hBitmap;      // snapshot 32bpp (DIB section)
    const DWORD* srcBits;      // bits du snapshot
    RECT         targetRect;
    int          width, height;
    int          targetDockX, targetDockY;
    BOOL         isRising;
    LONG_PTR     originalExStyle;
    int          durationMs;
    double       bendPct;      // 0.15 .. 0.70
    int          iconWidth;
};

std::unordered_map<HWND, HBITMAP> g_SnapshotCache;
