    g_leftIconCount.store(leftIconCount, std::memory_order_release);

    int centerPinnedCount = Wh_GetIntSetting(L"centerPinnedIconCount");
    if (centerPinnedCount < 0) {
        centerPinnedCount = kDefaultCenterPinnedIconCount;
    }
    g_centerPinnedIconCount.store(centerPinnedCount, std::memory_order_release);

    PCWSTR expandSide = Wh_GetStringSetting(L"firstExpandSide");
    bool rightFirst = (expandSide && _wcsicmp(expandSide, L"right") == 0);
    Wh_FreeStringSetting(expandSide);
    g_expandRightFirst.store(rightFirst, std::memory_order_release);

    g_compactWingOnClose.store(Wh_GetIntSetting(L"compactWingOnClose") != 0,
                               std::memory_order_release);

    g_stopCenteringIconCount.store(
        std::max(0, Wh_GetIntSetting(L"stopCenteringIconCount")),
        std::memory_order_release);

    g_settingsGeneration.fetch_add(1, std::memory_order_release);
}

// ============================================================================
// Safe Taskbar-on-Top via SHAppBarMessage Hook & Non-Looping Subclass
// ============================================================================

constexpr UINT_PTR kTopTaskbarSubclassId = 0x5748544F;  // 'WHTO'

struct SubclassedTopTaskbarInfo {
    HWND hWnd = nullptr;
    bool appliedTopState = false;
};

thread_local std::vector<SubclassedTopTaskbarInfo>* g_subclassedTaskbars =
    nullptr;

bool IsTaskbarWindowClass(HWND hWnd) {
    if (!hWnd) {
        return false;
    }
    WCHAR className[32]{};
    if (!GetClassNameW(hWnd, className, ARRAYSIZE(className))) {
        return false;
    }
    return _wcsicmp(className, L"Shell_TrayWnd") == 0 ||
           _wcsicmp(className, L"Shell_SecondaryTrayWnd") == 0;
}

using SHAppBarMessage_t = UINT_PTR(WINAPI*)(DWORD dwMessage, PAPPBARDATA pData);
SHAppBarMessage_t SHAppBarMessage_Original;

UINT_PTR WINAPI SHAppBarMessage_Hook(DWORD dwMessage, PAPPBARDATA pData) {
    if (pData && !g_unloading.load(std::memory_order_acquire) &&
        g_placeTaskbarOnTop.load(std::memory_order_acquire)) {
        if ((dwMessage == ABM_QUERYPOS || dwMessage == ABM_SETPOS) &&
            pData->hWnd && IsTaskbarWindowClass(pData->hWnd)) {
            HMONITOR hMon =
                MonitorFromWindow(pData->hWnd, MONITOR_DEFAULTTONEAREST);
            MONITORINFO mi{};
            mi.cbSize = sizeof(mi);
            if (hMon && GetMonitorInfoW(hMon, &mi)) {
                int height = pData->rc.bottom - pData->rc.top;
                int monHeight = mi.rcMonitor.bottom - mi.rcMonitor.top;
                if (height <= 0 || height > monHeight / 3) {
                    RECT rcWnd{};
                    if (GetWindowRect(pData->hWnd, &rcWnd)) {
                        height = rcWnd.bottom - rcWnd.top;
                    }
                    if (height <= 0 || height > monHeight / 3) {
                        height = 48;
                    }
                }
                pData->uEdge = ABE_TOP;
                pData->rc.top = mi.rcMonitor.top;
                pData->rc.bottom = mi.rcMonitor.top + height;
            }
        }
    }
    return SHAppBarMessage_Original(dwMessage, pData);
}

LRESULT CALLBACK TopTaskbarSubclassProc(HWND hWnd,
                                        UINT uMsg,
                                        WPARAM wParam,
                                        LPARAM lParam,
                                        UINT_PTR /*uIdSubclass*/,
                                        DWORD_PTR /*dwRefData*/) {
    if (uMsg == WM_WINDOWPOSCHANGING && lParam &&
        !g_unloading.load(std::memory_order_acquire) &&
        g_placeTaskbarOnTop.load(std::memory_order_acquire)) {
        auto* wp = reinterpret_cast<WINDOWPOS*>(lParam);
        if (!(wp->flags & SWP_NOMOVE)) {
            HMONITOR hMon = MonitorFromWindow(hWnd, MONITOR_DEFAULTTONEAREST);
            MONITORINFO mi{};
            mi.cbSize = sizeof(mi);
            if (hMon && GetMonitorInfoW(hMon, &mi)) {
                int monHeight = mi.rcMonitor.bottom - mi.rcMonitor.top;
                int height = wp->cy;
                if ((wp->flags & SWP_NOSIZE) || height <= 0) {
                    RECT rcWnd{};
                    GetWindowRect(hWnd, &rcWnd);
                    height = rcWnd.bottom - rcWnd.top;
                }
                if (height > 0 && height < monHeight / 3) {
                    wp->y = mi.rcMonitor.top;
                }
            }
        }
    }
    return DefSubclassProc(hWnd, uMsg, wParam, lParam);
}

void ApplyTopTaskbarToWindowOnThread(HWND taskbarWnd, bool enable) {
    if (!taskbarWnd || !IsWindow(taskbarWnd)) {
        return;
    }
    if (!g_subclassedTaskbars) {
        g_subclassedTaskbars = new std::vector<SubclassedTopTaskbarInfo>();
    }

    auto it = std::find_if(g_subclassedTaskbars->begin(),
                           g_subclassedTaskbars->end(),
                           [taskbarWnd](SubclassedTopTaskbarInfo const& info) {
                               return info.hWnd == taskbarWnd;
                           });

    if (enable && it != g_subclassedTaskbars->end() && it->appliedTopState) {
        return;
    }
    if (!enable &&
        (it == g_subclassedTaskbars->end() || !it->appliedTopState)) {
        return;
    }

    HMONITOR hMon = MonitorFromWindow(taskbarWnd, MONITOR_DEFAULTTONEAREST);
    MONITORINFO mi{};
    mi.cbSize = sizeof(mi);
    bool hasMon = hMon && GetMonitorInfoW(hMon, &mi);

    RECT rcWnd{};
    GetWindowRect(taskbarWnd, &rcWnd);
    int wndWidth = rcWnd.right - rcWnd.left;
    int wndHeight = rcWnd.bottom - rcWnd.top;

    if (enable) {
        if (it == g_subclassedTaskbars->end()) {
            if (SetWindowSubclass(taskbarWnd, TopTaskbarSubclassProc,
                                  kTopTaskbarSubclassId, 0)) {
                g_subclassedTaskbars->push_back({taskbarWnd, true});
            }
        } else {
            it->appliedTopState = true;
        }

        SendNotifyMessageW(taskbarWnd, WM_SETTINGCHANGE, SPI_SETWORKAREA, 0);
        if (hasMon && wndHeight > 0 &&
            wndHeight < (mi.rcMonitor.bottom - mi.rcMonitor.top) / 3) {
            SetWindowPos(taskbarWnd, nullptr, mi.rcMonitor.left,
                         mi.rcMonitor.top, wndWidth, wndHeight,
                         SWP_NOZORDER | SWP_NOACTIVATE);
        }
    } else {
        if (it != g_subclassedTaskbars->end()) {
            RemoveWindowSubclass(taskbarWnd, TopTaskbarSubclassProc,
                                 kTopTaskbarSubclassId);
            g_subclassedTaskbars->erase(it);
        }

        SendNotifyMessageW(taskbarWnd, WM_SETTINGCHANGE, SPI_SETWORKAREA, 0);
        if (hasMon && wndHeight > 0 &&
            wndHeight < (mi.rcMonitor.bottom - mi.rcMonitor.top) / 3) {
            SetWindowPos(taskbarWnd, nullptr, mi.rcMonitor.left,
                         mi.rcMonitor.bottom - wndHeight, wndWidth, wndHeight,
                         SWP_NOZORDER | SWP_NOACTIVATE);
        }
    }
}

void CleanupTopTaskbarSubclassesOnThread() {
    if (!g_subclassedTaskbars) {
        return;
    }
    auto copy = *g_subclassedTaskbars;
    for (auto const& info : copy) {
        ApplyTopTaskbarToWindowOnThread(info.hWnd, false);
    }
    delete g_subclassedTaskbars;
    g_subclassedTaskbars = nullptr;
}

