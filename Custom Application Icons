// A shell asks a window for its icon with SendMessageTimeout, never plain
// SendMessage - it must not hang on an unresponsive program. Both RetroBar and
// the window switcher go through here.
#define DEFINE_SENDMESSAGETIMEOUT_HOOK(name)                                   \
    using name##_t = decltype(&name);                                          \
    static name##_t name##_orig;                                               \
    static LRESULT WINAPI name##_hook(HWND hWnd, UINT Msg, WPARAM wParam,      \
                                      LPARAM lParam, UINT fuFlags,             \
                                      UINT uTimeout, PDWORD_PTR lpdwResult) {  \
        if (Msg == WM_GETICON && g_haveRules.load(std::memory_order_relaxed) && \
            g_optRemote.load(std::memory_order_relaxed) &&                     \
            !GetPropW(hWnd, kHandledProp)) {                                   \
            DWORD_PTR answer = 0;                                              \
            LRESULT delivered = name##_orig(hWnd, Msg, wParam, lParam,         \
                                            fuFlags, uTimeout, &answer);       \
            HICON hIcon = IconForRemoteWindow(                                 \
                hWnd, wParam == ICON_BIG, (HICON)(delivered ? answer : 0));    \
            if (lpdwResult) {                                                  \
                *lpdwResult = hIcon ? (DWORD_PTR)hIcon : answer;               \
            }                                                                  \
            return hIcon ? 1 : delivered;                                      \
        }                                                                      \
        return name##_orig(hWnd, Msg, wParam, lParam, fuFlags, uTimeout,       \
                           lpdwResult);                                        \
    }

DEFINE_SENDMESSAGETIMEOUT_HOOK(SendMessageTimeoutW)
DEFINE_SENDMESSAGETIMEOUT_HOOK(SendMessageTimeoutA)

