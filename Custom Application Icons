// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

static inline WCHAR LowerChar(WCHAR c) {
    return (WCHAR)(ULONG_PTR)CharLowerW((LPWSTR)(ULONG_PTR)(WORD)c);
}

// Case-insensitive wildcard match supporting * and ?, iterative with
// backtracking so a pathological pattern can't blow the stack.
static bool WildcardMatch(PCWSTR pattern, PCWSTR text) {
    PCWSTR star = nullptr;
    PCWSTR mark = nullptr;
    while (*text) {
        if (*pattern == L'?' ||
            (*pattern && LowerChar(*pattern) == LowerChar(*text))) {
            pattern++;
            text++;
        } else if (*pattern == L'*') {
            star = pattern++;
            mark = text;
        } else if (star) {
            pattern = star + 1;
            text = ++mark;
        } else {
            return false;
        }
    }
    while (*pattern == L'*') {
        pattern++;
    }
    return *pattern == L'\0';
}

static PCWSTR FileNamePart(PCWSTR path) {
    PCWSTR name = path;
    for (PCWSTR p = path; *p; p++) {
        if (*p == L'\\' || *p == L'/') {
            name = p + 1;
        }
    }
    return name;
}

static std::wstring ExpandAndTrim(PCWSTR value) {
    std::wstring s = value ? value : L"";
    while (!s.empty() && (s.front() == L' ' || s.front() == L'\t')) {
        s.erase(s.begin());
    }
    while (!s.empty() && (s.back() == L' ' || s.back() == L'\t')) {
        s.pop_back();
    }
    if (s.size() >= 2 && s.front() == L'"' && s.back() == L'"') {
        s = s.substr(1, s.size() - 2);
    }
    if (s.find(L'%') != std::wstring::npos) {
        WCHAR expanded[MAX_PATH * 2];
        DWORD n =
            ExpandEnvironmentStringsW(s.c_str(), expanded, ARRAYSIZE(expanded));
        if (n > 0 && n <= ARRAYSIZE(expanded)) {
            s = expanded;
        }
    }
    return s;
}

