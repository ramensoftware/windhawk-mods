using PrivateExtractIconsW_t = decltype(&PrivateExtractIconsW);
static PrivateExtractIconsW_t PrivateExtractIconsW_orig;

static UINT WINAPI PrivateExtractIconsW_hook(LPCWSTR szFileName,
                                             int nIconIndex,
                                             int cxIcon,
                                             int cyIcon,
                                             HICON* phicon,
                                             UINT* piconid,
                                             UINT nIcons,
