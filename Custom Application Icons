    if (phicon && nIcons == 1 && nIconIndex == 0 &&
        g_haveRules.load(std::memory_order_relaxed) &&
        g_optFileIcons.load(std::memory_order_relaxed)) {
        HICON hIcon = IconForFile(szFileName, cxIcon, cyIcon);
        if (hIcon) {
            *phicon = hIcon;
            if (piconid) {
                *piconid = 0;
            }
            return 1;
        }
    }

    return PrivateExtractIconsW_orig(szFileName, nIconIndex, cxIcon, cyIcon,
                                     phicon, piconid, nIcons, flags);
}

using ExtractIconExW_t = decltype(&ExtractIconExW);
static ExtractIconExW_t ExtractIconExW_orig;

static UINT WINAPI ExtractIconExW_hook(LPCWSTR lpszFile,
                                       int nIconIndex,
                                       HICON* phiconLarge,
                                       HICON* phiconSmall,
                                       UINT nIcons) {
    if (nIconIndex == 0 && nIcons == 1 && (phiconLarge || phiconSmall) &&
        g_haveRules.load(std::memory_order_relaxed) &&
        g_optFileIcons.load(std::memory_order_relaxed)) {
        HICON hLarge = phiconLarge
                           ? IconForFile(lpszFile, GetSystemMetrics(SM_CXICON),
                                         GetSystemMetrics(SM_CYICON))
                           : nullptr;
        HICON hSmall =
            phiconSmall ? IconForFile(lpszFile, GetSystemMetrics(SM_CXSMICON),
                                      GetSystemMetrics(SM_CYSMICON))
                        : nullptr;
        if (hLarge || hSmall) {
            if (phiconLarge) {
                *phiconLarge = hLarge;
            }
            if (phiconSmall) {
                *phiconSmall = hSmall;
            }
            return 1;
        }
    }

    return ExtractIconExW_orig(lpszFile, nIconIndex, phiconLarge, phiconSmall,
                               nIcons);
}

using SHGetFileInfoW_t = decltype(&SHGetFileInfoW);
static SHGetFileInfoW_t SHGetFileInfoW_orig;

static DWORD_PTR WINAPI SHGetFileInfoW_hook(LPCWSTR pszPath,
                                            DWORD dwFileAttributes,
                                            SHFILEINFOW* psfi,
                                            UINT cbFileInfo,
                                            UINT uFlags) {
    DWORD_PTR result = SHGetFileInfoW_orig(pszPath, dwFileAttributes, psfi,
                                           cbFileInfo, uFlags);

    if (result && psfi && (uFlags & SHGFI_ICON) && !(uFlags & SHGFI_PIDL) &&
        cbFileInfo >= sizeof(SHFILEINFOW) &&
        g_haveRules.load(std::memory_order_relaxed) &&
        g_optFileIcons.load(std::memory_order_relaxed)) {
        bool wantSmall = (uFlags & SHGFI_SMALLICON) != 0;
        HICON hIcon =
            IconForFile(pszPath, GetSystemMetrics(wantSmall ? SM_CXSMICON : SM_CXICON),
                        GetSystemMetrics(wantSmall ? SM_CYSMICON : SM_CYICON));
        if (hIcon) {
            if (psfi->hIcon) {
                DestroyIcon(psfi->hIcon);
            }
            psfi->hIcon = hIcon;
        }
    }

    return result;
}

// ---------------------------------------------------------------------------
// Applying and refreshing
// ---------------------------------------------------------------------------

static void RememberOriginal(HWND hWnd, bool big, HICON hOriginal,
                             HICON hOurs) {
    AcquireSRWLockExclusive(&g_stateLock);
    WindowOriginal& entry = g_windowOriginals[hWnd];
    if (big) {
        if (!entry.hOurBig) {
            entry.hBig = hOriginal;
        }
        entry.hOurBig = hOurs;
    } else {
        if (!entry.hOurSmall) {
            entry.hSmall = hOriginal;
        }
        entry.hOurSmall = hOurs;
    }
    ReleaseSRWLockExclusive(&g_stateLock);
}

// A copy is handed to the window: a program is free to destroy the icon a
// WM_SETICON call returned to it, and that must not take out the master.
static void PushWindowIcon(HWND hWnd, bool big, HICON hIcon) {
    HICON hCopy = CopyIcon(hIcon);
    if (!hCopy) {
        return;
    }

    AcquireSRWLockExclusive(&g_stateLock);
    g_ownedIcons.push_back(hCopy);
    ReleaseSRWLockExclusive(&g_stateLock);

    DWORD_PTR previous = 0;
    g_inPush = true;
    BOOL sent = SendMessageTimeoutW(hWnd, WM_SETICON, big ? ICON_BIG : ICON_SMALL,
                                    (LPARAM)hCopy, SMTO_ABORTIFHUNG | SMTO_NORMAL,
                                    300, &previous);
    g_inPush = false;
    if (sent) {
        RememberOriginal(hWnd, big, (HICON)previous, hCopy);
    }
}

// Some windows never pass WM_GETICON to DefWindowProc - a program built on
// SDL, for instance, keeps its icon in the window class. Consumers fall back
// to GCLP_HICON when the message returns nothing, so the class is patched too,
// once per class, through the first window seen from it.
static void PushClassIcon(HWND hWnd, HICON hSmall, HICON hBig) {
    ATOM atom = (ATOM)GetClassLongPtrW(hWnd, GCW_ATOM);
    if (!atom) {
        return;
    }

    AcquireSRWLockShared(&g_stateLock);
    bool alreadyPatched = g_classOriginals.find(atom) != g_classOriginals.end();
    ReleaseSRWLockShared(&g_stateLock);
    if (alreadyPatched) {
        return;
    }

    ClassOriginal original;
    original.hWnd = hWnd;

    HICON copySmall = hSmall ? CopyIcon(hSmall) : nullptr;
    HICON copyBig = hBig ? CopyIcon(hBig) : nullptr;
    if (copySmall) {
        original.hSmall = (HICON)SetClassLongPtrW(hWnd, GCLP_HICONSM,
                                                  (LONG_PTR)copySmall);
    }
    if (copyBig) {
        original.hBig =
            (HICON)SetClassLongPtrW(hWnd, GCLP_HICON, (LONG_PTR)copyBig);
    }

    AcquireSRWLockExclusive(&g_stateLock);
    if (g_classOriginals.find(atom) == g_classOriginals.end()) {
        g_classOriginals[atom] = original;
        if (copySmall) {
            g_ownedIcons.push_back(copySmall);
        }
        if (copyBig) {
            g_ownedIcons.push_back(copyBig);
        }
        copySmall = copyBig = nullptr;
    }
    ReleaseSRWLockExclusive(&g_stateLock);

    // Lost a race with another thread patching the same class.
    if (copySmall) {
        DestroyIcon(copySmall);
    }
    if (copyBig) {
        DestroyIcon(copyBig);
    }
}

static void RestoreClassIcons() {
    std::map<ATOM, ClassOriginal> originals;
    AcquireSRWLockExclusive(&g_stateLock);
    originals.swap(g_classOriginals);
    ReleaseSRWLockExclusive(&g_stateLock);

    for (const auto& [atom, original] : originals) {
        if (!original.hWnd || !IsWindow(original.hWnd)) {
            continue;
        }
        SetClassLongPtrW(original.hWnd, GCLP_HICONSM, (LONG_PTR)original.hSmall);
        SetClassLongPtrW(original.hWnd, GCLP_HICON, (LONG_PTR)original.hBig);
    }
}

// Re-setting the title makes the shell re-read the window: RetroBar, the
// Windows taskbar and anything else on the shell hook reload the icon when
// HSHELL_REDRAW arrives.
static void PokeShell(HWND hWnd) {
    WCHAR title[512];
    if (GetWindowTextW(hWnd, title, ARRAYSIZE(title)) >= 0) {
        DWORD_PTR unused = 0;
        SendMessageTimeoutW(hWnd, WM_SETTEXT, 0, (LPARAM)title,
                            SMTO_ABORTIFHUNG | SMTO_NORMAL, 300, &unused);
    }
}

struct SweepContext {
    DWORD processId;
    bool push;
    bool poke;
    bool retrigger;
};

static BOOL CALLBACK SweepWindowProc(HWND hWnd, LPARAM lParam) {
    SweepContext* context = (SweepContext*)lParam;

    DWORD processId = 0;
    GetWindowThreadProcessId(hWnd, &processId);
    if (processId != context->processId) {
        return TRUE;
    }

    if (context->retrigger && g_taskbarCreatedMsg) {
        DWORD_PTR unused = 0;
        SendMessageTimeoutW(hWnd, g_taskbarCreatedMsg, 0, 0,
                            SMTO_ABORTIFHUNG | SMTO_NORMAL, 300, &unused);
    }

    HICON hSmall = IconForWindow(hWnd, false, nullptr);
    HICON hBig = IconForWindow(hWnd, true, nullptr);
    if (!hSmall && !hBig) {
        return TRUE;
    }

    if (context->push) {
        if (hSmall) {
            PushWindowIcon(hWnd, false, hSmall);
        }
        if (hBig) {
            PushWindowIcon(hWnd, true, hBig);
        }
        PushClassIcon(hWnd, hSmall, hBig);
    }
    if (context->poke) {
        PokeShell(hWnd);
    }

    return TRUE;
}

static void ApplyToExistingWindows(bool poke, bool retrigger) {
    if (!g_activeHere.load()) {
        return;
    }

    SweepContext context = {};
    context.processId = GetCurrentProcessId();
    // Assigning our icon to the window would overwrite the icon that tells the
    // states apart, so a state-specific setup answers requests instead.
    context.push = g_optWindows.load() && g_optPush.load();
    context.poke = poke && g_optWindows.load();
    context.retrigger = retrigger && g_optTray.load() && g_optRetrigger.load();

    if (!context.push && !context.poke && !context.retrigger) {
        return;
    }

    EnumWindows(SweepWindowProc, (LPARAM)&context);
}

// For a window the mod cannot reach from inside, nothing tells the taskbar its
// icon changed. A shell learns that from the shell hook, so the notification is
// posted here, from inside the shell's own process - which is where this code
// runs when the taskbar is the one asking.
struct RemoteRefresh {
    DWORD ownProcessId;
    std::vector<HWND> targets;
    std::vector<HWND> listeners;
};

static BOOL CALLBACK CollectRemoteProc(HWND hWnd, LPARAM lParam) {
    RemoteRefresh* refresh = (RemoteRefresh*)lParam;

    DWORD processId = 0;
    GetWindowThreadProcessId(hWnd, &processId);
    if (processId == refresh->ownProcessId) {
        refresh->listeners.push_back(hWnd);
        return TRUE;
    }

    if (!IsWindowVisible(hWnd)) {
        return TRUE;
    }

    std::wstring exePath;
    if (PathOfWindowProcess(hWnd, processId, &exePath) &&
        RuleIndexForPath(exePath.c_str(), nullptr, false) >= 0) {
        refresh->targets.push_back(hWnd);
    }
    return TRUE;
}

static void RefreshRemoteWindows() {
    if (!g_haveRules.load() || !g_optRemote.load() || !g_shellHookMsg) {
        return;
    }

    RemoteRefresh refresh;
    refresh.ownProcessId = GetCurrentProcessId();
    EnumWindows(CollectRemoteProc, (LPARAM)&refresh);

    if (refresh.targets.empty()) {
        return;
    }

    for (HWND listener : refresh.listeners) {
        for (HWND target : refresh.targets) {
            PostMessageW(listener, g_shellHookMsg, HSHELL_REDRAW,
                         (LPARAM)target);
        }
    }
}

// Re-sends every tray icon this process registered, with the new image.
static void RefreshTrayIcons() {
    if (!Shell_NotifyIconW_orig || !g_activeHere.load() || !g_optTray.load()) {
        return;
    }

    std::vector<TrayEntry> entries;
    AcquireSRWLockShared(&g_stateLock);
    entries = g_trayEntries;
    ReleaseSRWLockShared(&g_stateLock);

    for (const TrayEntry& entry : entries) {
        // The icon the program last handed over says which state it is in, so
        // a state rule survives a settings change without waiting for the
        // program to update its icon on its own.
        HICON hIcon = IconForTray(entry.hOriginal, entry.tooltip.c_str());
        if (!hIcon) {
            // No rule covers this icon any more - put the program's own back,
            // so removing a rule is visible at once instead of at the next
            // time the program happens to redraw.
            hIcon = entry.hOriginal;
        }
        if (!hIcon) {
            continue;
        }

        NOTIFYICONDATAW data = {};
        data.cbSize = sizeof(data);
        data.hWnd = entry.hWnd;
        data.uID = entry.uID;
        data.uFlags = NIF_ICON;
        data.hIcon = hIcon;
        if (entry.hasGuid) {
            data.uFlags |= NIF_GUID;
            data.guidItem = entry.guid;
        }
        Shell_NotifyIconW_orig(NIM_MODIFY, &data);
    }
}

static void RestoreTrayIcons() {
    if (!Shell_NotifyIconW_orig) {
        return;
    }

    std::vector<TrayEntry> entries;
    AcquireSRWLockShared(&g_stateLock);
    entries = g_trayEntries;
    ReleaseSRWLockShared(&g_stateLock);

    for (const TrayEntry& entry : entries) {
        if (!entry.hOriginal) {
            continue;
        }
        NOTIFYICONDATAW data = {};
        data.cbSize = sizeof(data);
        data.hWnd = entry.hWnd;
        data.uID = entry.uID;
        data.uFlags = NIF_ICON;
        data.hIcon = entry.hOriginal;
        if (entry.hasGuid) {
            data.uFlags |= NIF_GUID;
            data.guidItem = entry.guid;
        }
        Shell_NotifyIconW_orig(NIM_MODIFY, &data);
    }
}

static void RestoreWindowIcons() {
    std::map<HWND, WindowOriginal> originals;
    AcquireSRWLockExclusive(&g_stateLock);
    originals.swap(g_windowOriginals);
    ReleaseSRWLockExclusive(&g_stateLock);

    for (const auto& [hWnd, entry] : originals) {
        if (!IsWindow(hWnd)) {
            continue;
        }
        DWORD_PTR unused = 0;
        if (entry.hOurSmall) {
            SendMessageTimeoutW(hWnd, WM_SETICON, ICON_SMALL,
                                (LPARAM)entry.hSmall,
                                SMTO_ABORTIFHUNG | SMTO_NORMAL, 300, &unused);
        }
        if (entry.hOurBig) {
            SendMessageTimeoutW(hWnd, WM_SETICON, ICON_BIG, (LPARAM)entry.hBig,
                                SMTO_ABORTIFHUNG | SMTO_NORMAL, 300, &unused);
        }
        PokeShell(hWnd);
    }
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

static void LoadSettings() {
    std::vector<Rule> rules;
    // A row left blank in the middle of the list must not cut the rest off, so
    // the scan only gives up after a run of empty entries.
    int emptyInARow = 0;
    for (int i = 0; i < 200 && emptyInARow < 5; i++) {
        PCWSTR process = Wh_GetStringSetting(L"rules[%d].process", i);
        PCWSTR icon = Wh_GetStringSetting(L"rules[%d].icon", i);
        PCWSTR windowClass = Wh_GetStringSetting(L"rules[%d].windowClass", i);
        PCWSTR windowTitle = Wh_GetStringSetting(L"rules[%d].windowTitle", i);
        PCWSTR trayTooltip = Wh_GetStringSetting(L"rules[%d].trayTooltip", i);
        PCWSTR originalIcon = Wh_GetStringSetting(L"rules[%d].originalIcon", i);
        PCWSTR originalColor = Wh_GetStringSetting(L"rules[%d].originalColor", i);

        bool empty = !*process && !*icon && !*windowClass && !*windowTitle &&
                     !*trayTooltip && !*originalIcon && !*originalColor;
        emptyInARow = empty ? emptyInARow + 1 : 0;
        if (!empty) {
            Rule rule;
            rule.processPatterns = SplitPatterns(ExpandAndTrim(process));
            rule.windowClass = ExpandAndTrim(windowClass);
            rule.windowTitle = ExpandAndTrim(windowTitle);
            rule.trayTooltip = ExpandAndTrim(trayTooltip);
            for (const std::wstring& hash :
                 SplitPatterns(ExpandAndTrim(originalIcon))) {
                WCHAR* end = nullptr;
                uint64_t value = wcstoull(hash.c_str(), &end, 16);
                if (value && end && !*end) {
                    rule.originalHashes.push_back(value);
                } else {
                    Wh_Log(L"Not a fingerprint: %s", hash.c_str());
                }
            }
            for (const std::wstring& spec :
                 SplitPatterns(ExpandAndTrim(originalColor))) {
                std::wstring text = spec;
                if (!text.empty() && text.front() == L'#') {
                    text.erase(text.begin());
                }
                ColorCondition color;
                WCHAR* end = nullptr;
                unsigned long value = wcstoul(text.c_str(), &end, 16);
                if (!end || (end - text.c_str()) < 6) {
                    Wh_Log(L"Not a colour: %s", spec.c_str());
                    continue;
                }
                color.r = (int)((value >> 16) & 0xFF);
                color.g = (int)((value >> 8) & 0xFF);
                color.b = (int)(value & 0xFF);
                if (*end == L',') {
                    color.tolerance = (int)wcstol(end + 1, &end, 10);
                    if (*end == L',') {
                        color.minPixels = (int)wcstol(end + 1, &end, 10);
                    }
                }
                if (color.tolerance < 0) {
                    color.tolerance = 0;
                }
                if (color.minPixels < 1) {
                    color.minPixels = 1;
                }
                rule.originalColors.push_back(color);
            }
            rule.icon = ParseIconSpec(icon);
            // A rule with no icon is legitimate: it puts the program under
            // capture without changing anything yet.
            if (!rule.processPatterns.empty()) {
                rules.push_back(std::move(rule));
            }
        }

        Wh_FreeStringSetting(process);
        Wh_FreeStringSetting(icon);
        Wh_FreeStringSetting(windowClass);
        Wh_FreeStringSetting(windowTitle);
        Wh_FreeStringSetting(trayTooltip);
        Wh_FreeStringSetting(originalIcon);
        Wh_FreeStringSetting(originalColor);
    }

    g_optTray = Wh_GetIntSetting(L"inTray") != 0;
    g_optWindows = Wh_GetIntSetting(L"inWindows") != 0;
    g_optFileIcons = Wh_GetIntSetting(L"inFileIcons") != 0;
    g_optPush = Wh_GetIntSetting(L"pushWindowIcons") != 0;
    g_optRemote = Wh_GetIntSetting(L"inOtherProcesses") != 0;
    g_optRetrigger = Wh_GetIntSetting(L"retriggerTrayIcons") != 0;
    g_optCapture = Wh_GetIntSetting(L"captureIcons") != 0;

    PCWSTR captureFolder = Wh_GetStringSetting(L"captureFolder");
    std::wstring folder = ExpandAndTrim(captureFolder);
    Wh_FreeStringSetting(captureFolder);
    while (!folder.empty() && folder.back() == L'\\') {
        folder.pop_back();
    }

    int smallCx = GetSystemMetrics(SM_CXSMICON);
    int smallCy = GetSystemMetrics(SM_CYSMICON);
    int bigCx = GetSystemMetrics(SM_CXICON);
    int bigCy = GetSystemMetrics(SM_CYICON);

    std::vector<LocalRule> localRules;
    for (const Rule& rule : rules) {
        if (!ProcessMatches(rule.processPatterns, g_exePath, g_exeName)) {
            continue;
        }

        LocalRule local;
        local.windowClass = rule.windowClass;
        local.windowTitle = rule.windowTitle;
        local.trayTooltip = rule.trayTooltip;
        local.originalHashes = rule.originalHashes;
        local.originalColors = rule.originalColors;
        if (!rule.icon.path.empty()) {
            local.hSmall = LoadIconAtSize(rule.icon, smallCx, smallCy);
            local.hBig = LoadIconAtSize(rule.icon, bigCx, bigCy);
            if (!local.hSmall && !local.hBig) {
                Wh_Log(L"No icon in %s", rule.icon.path.c_str());
                continue;
            }
        }
        localRules.push_back(std::move(local));
    }

    // Computed over every rule, not just the local ones: the taskbar-side path
    // matches windows of programs this process knows nothing about.
    bool needWindowInfo = false;
    bool needOriginal = false;
    bool anyStateRule = false;
    for (const Rule& rule : rules) {
        if (!rule.windowClass.empty() || !rule.windowTitle.empty()) {
            needWindowInfo = true;
        }
        if (!rule.originalHashes.empty() || !rule.originalColors.empty()) {
            needOriginal = true;
        }
        if (!rule.originalHashes.empty() || !rule.originalColors.empty() ||
            !rule.trayTooltip.empty()) {
            anyStateRule = true;
        }
    }

    if (needOriginal) {
        g_needOriginal = true;
    }
    if (needWindowInfo) {
        // Raise it before the new rules land, so no lookup can run against a
        // filtered rule without having collected the class and title.
        g_needWindowInfo = true;
    }

    AcquireSRWLockExclusive(&g_stateLock);
    // The previous icons are kept alive until unload: another process may
    // still be drawing a handle handed out a moment ago.
    for (const LocalRule& local : g_localRules) {
        if (local.hSmall) {
            g_ownedIcons.push_back(local.hSmall);
        }
        if (local.hBig) {
            g_ownedIcons.push_back(local.hBig);
        }
    }
    g_fileIconCache.clear();
    // Rule indices are about to change, so the per-window answers cached for
    // other processes are stale. Their handles may still be in use.
    for (auto& [staleWnd, stale] : g_remoteWindows) {
        if (stale.hSmallInFlight) {
            g_ownedIcons.push_back(stale.hSmallInFlight);
        }
        if (stale.hBigInFlight) {
            g_ownedIcons.push_back(stale.hBigInFlight);
        }
    }
    g_remoteWindows.clear();
    g_rules = std::move(rules);
    g_localRules = std::move(localRules);
    size_t ruleCount = g_rules.size();
    size_t localCount = g_localRules.size();
    ReleaseSRWLockExclusive(&g_stateLock);

    AcquireSRWLockExclusive(&g_stateLock);
    g_captureFolder = folder;
    g_capturedIcons.clear();
    g_lastCaptured.clear();
    g_iconSummaries.clear();
    ReleaseSRWLockExclusive(&g_stateLock);

    g_needWindowInfo = needWindowInfo;
    g_needOriginal = needOriginal;
    g_hasStateRules = anyStateRule;
    g_activeHere = localCount != 0;
    g_haveRules = ruleCount != 0;

    Wh_Log(L"%s: %d rules, %d for this process", g_exeName, (int)ruleCount,
           (int)localCount);
}

// ---------------------------------------------------------------------------
// Hook installation
// ---------------------------------------------------------------------------

static bool g_windowHooksInstalled;
static bool g_trayHooksInstalled;
static bool g_remoteHooksInstalled;
static bool g_user32FileHooksInstalled;
static bool g_shell32FileHooksInstalled;

// Returns true when new hooks were registered. Called again after a settings
// change, because a rule may have just named this process for the first time.
static bool InstallHooks() {
    bool added = false;

    HMODULE user32 = GetModuleHandleW(L"user32.dll");
    HMODULE shell32 = GetModuleHandleW(L"shell32.dll");

    // Only worth pulling shell32 into a process the user actually named.
    if (!shell32 && g_activeHere.load() && g_optTray.load()) {
        shell32 = LoadLibraryW(L"shell32.dll");
    }

    if (user32 && g_activeHere.load() && !g_windowHooksInstalled) {
        Wh_SetFunctionHook((void*)DefWindowProcW, (void*)DefWindowProcW_hook,
                           (void**)&DefWindowProcW_orig);
        Wh_SetFunctionHook((void*)DefWindowProcA, (void*)DefWindowProcA_hook,
                           (void**)&DefWindowProcA_orig);
        Wh_SetFunctionHook((void*)DefDlgProcW, (void*)DefDlgProcW_hook,
                           (void**)&DefDlgProcW_orig);
        Wh_SetFunctionHook((void*)DefDlgProcA, (void*)DefDlgProcA_hook,
                           (void**)&DefDlgProcA_orig);
        g_windowHooksInstalled = true;
        added = true;
    }

    if (shell32 && g_activeHere.load() && !g_trayHooksInstalled) {
        void* notifyW = (void*)GetProcAddress(shell32, "Shell_NotifyIconW");
        void* notifyA = (void*)GetProcAddress(shell32, "Shell_NotifyIconA");
        if (notifyW) {
            Wh_SetFunctionHook(notifyW, (void*)Shell_NotifyIconW_hook,
                               (void**)&Shell_NotifyIconW_orig);
            g_trayHooksInstalled = true;
            added = true;
        }
        if (notifyA) {
            Wh_SetFunctionHook(notifyA, (void*)Shell_NotifyIconA_hook,
                               (void**)&Shell_NotifyIconA_orig);
        }
    }

    if (user32 && g_haveRules.load() && g_optRemote.load() &&
        !g_remoteHooksInstalled) {
        void* timeoutW = (void*)GetProcAddress(user32, "SendMessageTimeoutW");
        void* timeoutA = (void*)GetProcAddress(user32, "SendMessageTimeoutA");
        if (timeoutW) {
            Wh_SetFunctionHook(timeoutW, (void*)SendMessageTimeoutW_hook,
                               (void**)&SendMessageTimeoutW_orig);
            g_remoteHooksInstalled = true;
            added = true;
        }
        if (timeoutA) {
            Wh_SetFunctionHook(timeoutA, (void*)SendMessageTimeoutA_hook,
                               (void**)&SendMessageTimeoutA_orig);
            g_remoteHooksInstalled = true;
            added = true;
        }
    }

    if (user32 && g_haveRules.load() && g_optFileIcons.load() &&
        !g_user32FileHooksInstalled) {
        void* extractIcons = (void*)GetProcAddress(user32, "PrivateExtractIconsW");
        if (extractIcons) {
            Wh_SetFunctionHook(extractIcons, (void*)PrivateExtractIconsW_hook,
                               (void**)&PrivateExtractIconsW_orig);
            g_user32FileHooksInstalled = true;
            added = true;
        }
    }

    if (shell32 && g_haveRules.load() && g_optFileIcons.load() &&
        !g_shell32FileHooksInstalled) {
        void* extractIconEx = (void*)GetProcAddress(shell32, "ExtractIconExW");
        void* fileInfo = (void*)GetProcAddress(shell32, "SHGetFileInfoW");
        if (extractIconEx) {
            Wh_SetFunctionHook(extractIconEx, (void*)ExtractIconExW_hook,
                               (void**)&ExtractIconExW_orig);
            g_shell32FileHooksInstalled = true;
            added = true;
        }
        if (fileInfo) {
            Wh_SetFunctionHook(fileInfo, (void*)SHGetFileInfoW_hook,
                               (void**)&SHGetFileInfoW_orig);
            g_shell32FileHooksInstalled = true;
            added = true;
        }
    }

    return added;
}

// ---------------------------------------------------------------------------
// Mod entry points
// ---------------------------------------------------------------------------

BOOL Wh_ModInit() {
    GetModuleFileNameW(nullptr, g_exePath, ARRAYSIZE(g_exePath));
    g_exeName = FileNamePart(g_exePath);
    g_taskbarCreatedMsg = RegisterWindowMessageW(L"TaskbarCreated");
    g_shellHookMsg = RegisterWindowMessageW(L"SHELLHOOK");

    LoadSettings();
    InstallHooks();

    return TRUE;
}

void Wh_ModAfterInit() {
    ApplyToExistingWindows(true, true);
    RefreshRemoteWindows();
}

void Wh_ModSettingsChanged() {
    LoadSettings();

    if (InstallHooks()) {
        Wh_ApplyHookOperations();
    }

    ApplyToExistingWindows(true, true);
    RefreshTrayIcons();
    RefreshRemoteWindows();
}

// The mark saying "answered inside this process" must not outlive the mod, or
// the taskbar-side hook would keep stepping around a window nobody handles.
static void ClearWindowMarks() {
    std::map<HWND, bool> marked;
    AcquireSRWLockExclusive(&g_stateLock);
    marked.swap(g_markedWindows);
    ReleaseSRWLockExclusive(&g_stateLock);

    for (const auto& [hWnd, unused] : marked) {
        if (IsWindow(hWnd)) {
            RemovePropW(hWnd, kHandledProp);
        }
    }
}

void Wh_ModBeforeUninit() {
    g_activeHere = false;
    g_haveRules = false;

    RestoreWindowIcons();
    RestoreClassIcons();
    RestoreTrayIcons();
    ClearWindowMarks();
}

void Wh_ModUninit() {
    AcquireSRWLockExclusive(&g_stateLock);
    for (const LocalRule& local : g_localRules) {
        if (local.hSmall) {
            g_ownedIcons.push_back(local.hSmall);
        }
        if (local.hBig) {
            g_ownedIcons.push_back(local.hBig);
        }
    }
    g_localRules.clear();
    for (auto& [remoteWnd, remote] : g_remoteWindows) {
        if (remote.hSmallInFlight) {
            g_ownedIcons.push_back(remote.hSmallInFlight);
        }
        if (remote.hBigInFlight) {
            g_ownedIcons.push_back(remote.hBigInFlight);
        }
    }
    g_remoteWindows.clear();
    for (auto& [stateWnd, icons] : g_windowState) {
        if (icons.ourSmallCopy) { g_ownedIcons.push_back(icons.ourSmallCopy); }
        if (icons.ourBigCopy) { g_ownedIcons.push_back(icons.ourBigCopy); }
    }
    g_windowState.clear();
    g_iconSummaries.clear();
    g_capturedIcons.clear();
    g_lastCaptured.clear();
    for (HICON hIcon : g_ownedIcons) {
        DestroyIcon(hIcon);
    }
    g_ownedIcons.clear();
    g_fileIconCache.clear();
    g_trayEntries.clear();
    ReleaseSRWLockExclusive(&g_stateLock);
}
