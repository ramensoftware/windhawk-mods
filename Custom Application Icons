using Shell_NotifyIconW_t = decltype(&Shell_NotifyIconW);
static Shell_NotifyIconW_t Shell_NotifyIconW_orig;
using Shell_NotifyIconA_t = decltype(&Shell_NotifyIconA);
static Shell_NotifyIconA_t Shell_NotifyIconA_orig;

// Remembering every icon the program registered is what lets a settings change
// reach a program that is already running.
static std::wstring TrackTrayIcon(DWORD dwMessage,
                                  HWND hWnd,
                                  UINT uID,
                                  UINT uFlags,
                                  const GUID* guid,
                                  HICON hOriginal,
                                  PCWSTR tooltip) {
    bool hasGuid = (uFlags & NIF_GUID) && guid;
    std::wstring known;

    AcquireSRWLockExclusive(&g_stateLock);

    auto it = g_trayEntries.begin();
    for (; it != g_trayEntries.end(); ++it) {
        if (hasGuid && it->hasGuid) {
            if (IsEqualGUID(it->guid, *guid)) {
                break;
            }
        } else if (it->hWnd == hWnd && it->uID == uID) {
            break;
        }
    }

    if (dwMessage == NIM_DELETE) {
        if (it != g_trayEntries.end()) {
            g_trayEntries.erase(it);
        }
    } else if (dwMessage == NIM_ADD || dwMessage == NIM_MODIFY) {
        if (it == g_trayEntries.end()) {
            g_trayEntries.push_back(TrayEntry{});
            it = g_trayEntries.end() - 1;
        }
        it->hWnd = hWnd;
        it->uID = uID;
        it->hasGuid = hasGuid;
        if (hasGuid) {
            it->guid = *guid;
        }
        if (hOriginal) {
            it->hOriginal = hOriginal;
        }
        if (tooltip && *tooltip) {
            it->tooltip = tooltip;
        }
        known = it->tooltip;
    }

    ReleaseSRWLockExclusive(&g_stateLock);
    return known;
}

static BOOL WINAPI Shell_NotifyIconW_hook(DWORD dwMessage,
                                          PNOTIFYICONDATAW lpData) {
    if (!lpData || !g_activeHere.load(std::memory_order_relaxed) ||
        !g_optTray.load(std::memory_order_relaxed) ||
        lpData->cbSize > sizeof(NOTIFYICONDATAW) ||
        lpData->cbSize < offsetof(NOTIFYICONDATAW, hIcon) + sizeof(HICON)) {
        return Shell_NotifyIconW_orig(dwMessage, lpData);
    }

    NOTIFYICONDATAW data = {};
    memcpy(&data, lpData, lpData->cbSize);

    const GUID* guid = nullptr;
    if (lpData->cbSize >= offsetof(NOTIFYICONDATAW, guidItem) + sizeof(GUID)) {
        guid = &data.guidItem;
    }

    std::wstring tooltip = TrackTrayIcon(
        dwMessage, data.hWnd, data.uID, data.uFlags, guid,
        (data.uFlags & NIF_ICON) ? data.hIcon : nullptr,
        (data.uFlags & NIF_TIP) ? data.szTip : nullptr);

    if (data.uFlags & NIF_ICON) {
        HICON hIcon = IconForTray(data.hIcon, tooltip.c_str());
        if (hIcon) {
            data.hIcon = hIcon;
        }
    }

    return Shell_NotifyIconW_orig(dwMessage, &data);
}

static BOOL WINAPI Shell_NotifyIconA_hook(DWORD dwMessage,
                                          PNOTIFYICONDATAA lpData) {
    if (!lpData || !g_activeHere.load(std::memory_order_relaxed) ||
        !g_optTray.load(std::memory_order_relaxed) ||
        lpData->cbSize > sizeof(NOTIFYICONDATAA) ||
        lpData->cbSize < offsetof(NOTIFYICONDATAA, hIcon) + sizeof(HICON)) {
        return Shell_NotifyIconA_orig(dwMessage, lpData);
    }

    NOTIFYICONDATAA data = {};
    memcpy(&data, lpData, lpData->cbSize);

    const GUID* guid = nullptr;
    if (lpData->cbSize >= offsetof(NOTIFYICONDATAA, guidItem) + sizeof(GUID)) {
        guid = &data.guidItem;
    }

    WCHAR wideTip[128] = L"";
    if (data.uFlags & NIF_TIP) {
        MultiByteToWideChar(CP_ACP, 0, data.szTip, -1, wideTip,
                            ARRAYSIZE(wideTip));
    }

    std::wstring tooltip = TrackTrayIcon(
        dwMessage, data.hWnd, data.uID, data.uFlags, guid,
        (data.uFlags & NIF_ICON) ? data.hIcon : nullptr,
        (data.uFlags & NIF_TIP) ? wideTip : nullptr);

    if (data.uFlags & NIF_ICON) {
        HICON hIcon = IconForTray(data.hIcon, tooltip.c_str());
        if (hIcon) {
            data.hIcon = hIcon;
        }
    }

    return Shell_NotifyIconA_orig(dwMessage, &data);
}

