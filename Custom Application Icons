// ---------------------------------------------------------------------------
// Icon loading
// ---------------------------------------------------------------------------

static IconSpec ParseIconSpec(PCWSTR value) {
    IconSpec spec;
    std::wstring s = ExpandAndTrim(value);

    size_t comma = s.find_last_of(L',');
    if (comma != std::wstring::npos && comma + 1 < s.size()) {
        PCWSTR numberStart = s.c_str() + comma + 1;
        WCHAR* end = nullptr;
        long index = wcstol(numberStart, &end, 10);
        if (end && *end == L'\0' && end != numberStart) {
            spec.index = (int)index;
            s.erase(comma);
            while (!s.empty() && s.back() == L' ') {
                s.pop_back();
            }
        }
    }

    spec.path = s;
    return spec;
}

// Loads an icon at an exact size. The caller owns the result.
static HICON LoadIconAtSize(const IconSpec& spec, int cx, int cy) {
    if (spec.path.empty() || cx <= 0 || cy <= 0) {
        return nullptr;
    }

    g_inIconLoad = true;

    HICON hIcon = nullptr;
    if (PrivateExtractIconsW(spec.path.c_str(), spec.index, cx, cy, &hIcon,
                             nullptr, 1, 0) != 1) {
        hIcon = nullptr;
    }
    if (!hIcon && spec.index == 0) {
        hIcon = (HICON)LoadImageW(nullptr, spec.path.c_str(), IMAGE_ICON, cx, cy,
                                  LR_LOADFROMFILE | LR_DEFAULTCOLOR);
    }

    g_inIconLoad = false;

    return hIcon;
}

// ---------------------------------------------------------------------------
// Recognising the icon a program hands out
//
// A program with several states - Discord muted, Telegram with unread mail -
// simply passes a different icon. Nothing names the state, so the icon itself
// is the identity: its pixels are fingerprinted, and a rule can ask for one
// fingerprint. Capture mode writes every icon seen to disk under its
// fingerprint, which is how one is found in the first place.
// ---------------------------------------------------------------------------

struct IconBits {
    int width = 0;
    int height = 0;
    std::vector<BYTE> color;  // 32bpp BGRA, bottom-up, as an .ico stores it
    std::vector<BYTE> mask;   // 1bpp, bottom-up, rows padded to 4 bytes
    bool valid = false;
};

static IconBits ReadIconBits(HICON hIcon) {
    IconBits bits;
    if (!hIcon) {
        return bits;
    }

    ICONINFO info = {};
    if (!GetIconInfo(hIcon, &info)) {
        return bits;
    }

    HBITMAP source = info.hbmColor ? info.hbmColor : info.hbmMask;
    BITMAP bitmap = {};
    if (GetObjectW(source, sizeof(bitmap), &bitmap) && bitmap.bmWidth > 0) {
        // A black and white icon keeps AND and XOR in one bitmap, stacked.
        int height = info.hbmColor ? bitmap.bmHeight : bitmap.bmHeight / 2;
        if (height > 0 && bitmap.bmWidth <= 512 && height <= 512) {
            bits.width = bitmap.bmWidth;
            bits.height = height;

            HDC hdc = GetDC(nullptr);

            BITMAPINFO colorInfo = {};
            colorInfo.bmiHeader.biSize = sizeof(colorInfo.bmiHeader);
            colorInfo.bmiHeader.biWidth = bits.width;
            colorInfo.bmiHeader.biHeight = bits.height;
            colorInfo.bmiHeader.biPlanes = 1;
            colorInfo.bmiHeader.biBitCount = 32;
            colorInfo.bmiHeader.biCompression = BI_RGB;
            bits.color.resize((size_t)bits.width * bits.height * 4);
            if (!GetDIBits(hdc, source, 0, bits.height, bits.color.data(),
                           &colorInfo, DIB_RGB_COLORS)) {
                bits.color.clear();
            }

            size_t stride = (((size_t)bits.width + 31) / 32) * 4;
            bits.mask.resize(stride * bits.height, 0);
            if (info.hbmMask) {
                BYTE buffer[sizeof(BITMAPINFOHEADER) + 2 * sizeof(RGBQUAD)] = {};
                BITMAPINFO* maskInfo = (BITMAPINFO*)buffer;
                maskInfo->bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
                maskInfo->bmiHeader.biWidth = bits.width;
                maskInfo->bmiHeader.biHeight = bits.height;
                maskInfo->bmiHeader.biPlanes = 1;
                maskInfo->bmiHeader.biBitCount = 1;
                maskInfo->bmiHeader.biCompression = BI_RGB;
                if (!GetDIBits(hdc, info.hbmMask, 0, bits.height,
                               bits.mask.data(), maskInfo, DIB_RGB_COLORS)) {
                    // An all-zero mask means fully opaque, which is right for
                    // the 32bpp icons everything uses today.
                }
            }

            ReleaseDC(nullptr, hdc);
            bits.valid = !bits.color.empty();
        }
    }

    if (info.hbmColor) {
        DeleteObject(info.hbmColor);
    }
    if (info.hbmMask) {
        DeleteObject(info.hbmMask);
    }
    return bits;
}

static uint64_t HashBytes(uint64_t hash, const void* data, size_t size) {
    const BYTE* bytes = (const BYTE*)data;
    for (size_t i = 0; i < size; i++) {
        hash ^= bytes[i];
        hash *= 1099511628211ULL;
    }
    return hash;
}

// Fingerprint of an icon's pixels, cached by handle. USER handles carry a
// uniqueness counter, so a value is not reused for a different icon.
static void BuildPalette(const IconBits& bits, std::vector<PaletteEntry>* out) {
    std::map<uint32_t, uint32_t> counts;
    for (int pass = 0; pass < 2 && counts.empty(); pass++) {
        // Second pass only happens for an old icon with no alpha channel,
        // where every pixel would otherwise look transparent.
        for (size_t i = 0; i + 3 < bits.color.size(); i += 4) {
            if (pass == 0 && bits.color[i + 3] < 200) {
                continue;
            }
            uint32_t rgb = ((uint32_t)bits.color[i + 2] << 16) |
                           ((uint32_t)bits.color[i + 1] << 8) | bits.color[i];
            auto it = counts.find(rgb);
            if (it != counts.end()) {
                it->second++;
            } else if (counts.size() < 1024) {
                counts[rgb] = 1;
            }
        }
    }

    out->clear();
    out->reserve(counts.size());
    for (const auto& [rgb, count] : counts) {
        out->push_back(PaletteEntry{rgb, count});
    }
}

// Fingerprint and colours of an icon, cached by handle. USER handles carry a
// uniqueness counter, so a value is not reused for a different icon.
static bool SummariseIcon(HICON hIcon, IconSummary* out) {
    if (!hIcon) {
        return false;
    }

    AcquireSRWLockShared(&g_stateLock);
    auto it = g_iconSummaries.find(hIcon);
    bool cached = it != g_iconSummaries.end();
    if (cached) {
        *out = it->second;
    }
    ReleaseSRWLockShared(&g_stateLock);
    if (cached) {
        return out->hash != 0;
    }

    IconBits bits = ReadIconBits(hIcon);
    if (!bits.valid) {
        return false;
    }

    IconSummary summary;
    summary.hash = HashBytes(1469598103934665603ULL, bits.color.data(),
                             bits.color.size());
    summary.hash = HashBytes(summary.hash, bits.mask.data(), bits.mask.size());
    if (!summary.hash) {
        summary.hash = 1;
    }
    BuildPalette(bits, &summary.palette);

    AcquireSRWLockExclusive(&g_stateLock);
    if (g_iconSummaries.size() > 128) {
        g_iconSummaries.clear();
    }
    g_iconSummaries[hIcon] = summary;
    ReleaseSRWLockExclusive(&g_stateLock);

    *out = std::move(summary);
    return true;
}

static bool EnsureDirectory(const std::wstring& path) {
    if (path.empty()) {
        return false;
    }
    for (size_t i = 0; i <= path.size(); i++) {
        if (i == path.size() || path[i] == L'\\') {
            if (i < 3) {
                continue;  // skip the drive letter
            }
            std::wstring part = path.substr(0, i);
            if (!CreateDirectoryW(part.c_str(), nullptr) &&
                GetLastError() != ERROR_ALREADY_EXISTS) {
                return false;
            }
        }
    }
    return true;
}

#pragma pack(push, 1)
struct IcoDirectory {
    WORD reserved;
    WORD type;
    WORD count;
};
struct IcoEntry {
    BYTE width;
    BYTE height;
    BYTE colorCount;
    BYTE reserved;
    WORD planes;
    WORD bitCount;
    DWORD bytesInRes;
    DWORD imageOffset;
};
#pragma pack(pop)

static bool WriteIconFile(const std::wstring& path, const IconBits& bits) {
    if (!bits.valid) {
        return false;
    }

    BITMAPINFOHEADER header = {};
    header.biSize = sizeof(header);
    header.biWidth = bits.width;
    header.biHeight = bits.height * 2;  // colour rows plus mask rows
    header.biPlanes = 1;
    header.biBitCount = 32;
    header.biCompression = BI_RGB;
    header.biSizeImage = (DWORD)bits.color.size();

    IcoDirectory directory = {0, 1, 1};
    IcoEntry entry = {};
    entry.width = bits.width >= 256 ? 0 : (BYTE)bits.width;
    entry.height = bits.height >= 256 ? 0 : (BYTE)bits.height;
    entry.planes = 1;
    entry.bitCount = 32;
    entry.bytesInRes =
        (DWORD)(sizeof(header) + bits.color.size() + bits.mask.size());
    entry.imageOffset = sizeof(directory) + sizeof(entry);

    HANDLE file = CreateFileW(path.c_str(), GENERIC_WRITE, FILE_SHARE_READ,
                              nullptr, CREATE_ALWAYS, 0, nullptr);
    if (file == INVALID_HANDLE_VALUE) {
        return false;
    }

    DWORD written = 0;
    bool ok = WriteFile(file, &directory, sizeof(directory), &written, nullptr) &&
              WriteFile(file, &entry, sizeof(entry), &written, nullptr) &&
              WriteFile(file, &header, sizeof(header), &written, nullptr) &&
              WriteFile(file, bits.color.data(), (DWORD)bits.color.size(),
                        &written, nullptr) &&
              WriteFile(file, bits.mask.data(), (DWORD)bits.mask.size(),
                        &written, nullptr);
    CloseHandle(file);
    return ok;
}

static void AppendIndexLine(const std::wstring& folder,
                            const std::wstring& line) {
    HANDLE file = CreateFileW((folder + L"\\captured.txt").c_str(),
                              FILE_APPEND_DATA, FILE_SHARE_READ | FILE_SHARE_WRITE,
                              nullptr, OPEN_ALWAYS, 0, nullptr);
    if (file == INVALID_HANDLE_VALUE) {
        return;
    }

    int size = WideCharToMultiByte(CP_UTF8, 0, line.c_str(), (int)line.size(),
                                   nullptr, 0, nullptr, nullptr);
    if (size > 0) {
        std::vector<char> utf8(size);
        WideCharToMultiByte(CP_UTF8, 0, line.c_str(), (int)line.size(),
                            utf8.data(), size, nullptr, nullptr);
        DWORD written = 0;
        WriteFile(file, utf8.data(), (DWORD)utf8.size(), &written, nullptr);
        WriteFile(file, "\r\n", 2, &written, nullptr);
    }
    CloseHandle(file);
}

// Writes an icon the program handed out to disk, once per fingerprint, so its
// states can be told apart by eye and addressed by rule.
static void CaptureIcon(HICON hIcon, uint64_t hash, PCWSTR source,
                        PCWSTR detail) {
    if (!g_optCapture.load(std::memory_order_relaxed) || !hIcon || !hash) {
        return;
    }

    // The .ico is written once per distinct icon, but the log gets a line
    // every time the icon *changes*: what a state sequence looks like is the
    // point of recording, and the second appearance of an icon matters as much
    // as the first.
    std::wstring folder;
    bool isNewIcon = false;
    bool changed = false;

    AcquireSRWLockExclusive(&g_stateLock);
    auto last = g_lastCaptured.find(source);
    changed = last == g_lastCaptured.end() || last->second != hash;
    if (changed) {
        g_lastCaptured[source] = hash;
    }
    isNewIcon = g_capturedIcons.find(hash) == g_capturedIcons.end() &&
                g_capturedIcons.size() < 200;
    if (isNewIcon) {
        g_capturedIcons[hash] = true;
    }
    if (changed || isNewIcon) {
        folder = g_captureFolder;
    }
    ReleaseSRWLockExclusive(&g_stateLock);

    if (folder.empty()) {
        return;
    }

    folder += L"\\";
    folder += g_exeName;
    if (!EnsureDirectory(folder)) {
        return;
    }

    IconBits bits = ReadIconBits(hIcon);
    if (!bits.valid) {
        return;
    }

    WCHAR name[128];
    wsprintfW(name, L"%08X%08X_%dx%d.ico", (DWORD)(hash >> 32), (DWORD)hash,
              bits.width, bits.height);
    if (isNewIcon) {
        WriteIconFile(folder + L"\\" + name, bits);
    }

    if (changed) {
        SYSTEMTIME now;
        GetLocalTime(&now);
        WCHAR line[512];
        wsprintfW(line, L"%02d:%02d:%02d  %08X%08X  %2dx%-2d  %-6s  %s",
                  now.wHour, now.wMinute, now.wSecond, (DWORD)(hash >> 32),
                  (DWORD)hash, bits.width, bits.height, source,
                  detail ? detail : L"");
        AppendIndexLine(folder, line);
    }

    Wh_Log(L"captured %s icon %08X%08X (%s)", source, (DWORD)(hash >> 32),
           (DWORD)hash, detail ? detail : L"");
}

// ---------------------------------------------------------------------------
// Rule lookup
// ---------------------------------------------------------------------------

// "steam.exe|steamwebhelper.exe" -> two patterns. Split once, at load time.
static std::vector<std::wstring> SplitPatterns(const std::wstring& value) {
    std::vector<std::wstring> patterns;
    size_t start = 0;
    while (start <= value.size()) {
        size_t end = value.find(L'|', start);
        if (end == std::wstring::npos) {
            end = value.size();
        }
        std::wstring one = value.substr(start, end - start);
        while (!one.empty() && (one.front() == L' ' || one.front() == L'\t')) {
            one.erase(one.begin());
        }
        while (!one.empty() && (one.back() == L' ' || one.back() == L'\t')) {
            one.pop_back();
        }
        if (!one.empty()) {
            patterns.push_back(std::move(one));
        }
        if (end == value.size()) {
            break;
        }
        start = end + 1;
    }
    return patterns;
}

static bool ProcessMatches(const std::vector<std::wstring>& patterns,
                           PCWSTR fullPath,
                           PCWSTR fileName) {
    for (const std::wstring& pattern : patterns) {
        if (WildcardMatch(pattern.c_str(), fileName)) {
            return true;
        }
        if (pattern.find(L'\\') != std::wstring::npos &&
            WildcardMatch(pattern.c_str(), fullPath)) {
            return true;
        }
    }
    return false;
}

// The window properties a rule may filter on. Collected without holding the
// lock - GetWindowTextW can send WM_GETTEXT to another thread.
struct WindowInfo {
    WCHAR className[128];
    WCHAR title[256];
    bool valid;
};

static void GetWindowInfo(HWND hWnd, WindowInfo* info) {
    info->className[0] = L'\0';
    info->title[0] = L'\0';
    info->valid = false;

    if (!hWnd || (!g_needWindowInfo.load(std::memory_order_relaxed) &&
                  !g_optCapture.load(std::memory_order_relaxed))) {
        return;
    }

    GetClassNameW(hWnd, info->className, ARRAYSIZE(info->className));
    GetWindowTextW(hWnd, info->title, ARRAYSIZE(info->title));
    info->valid = true;
}

static bool MatchesText(const std::wstring& pattern, PCWSTR text) {
    if (pattern.empty()) {
        return true;  // no condition
    }
    return text && WildcardMatch(pattern.c_str(), text);
}

static bool MatchesOriginal(const std::vector<uint64_t>& wanted,
                            const IconSummary* seen) {
    if (wanted.empty()) {
        return true;  // rule does not care which icon is being replaced
    }
    if (!seen) {
        return false;  // rule asks for a specific icon and none was seen
    }
    for (uint64_t hash : wanted) {
        if (hash == seen->hash) {
            return true;
        }
    }
    return false;
}

// A program that redraws its icon - Telegram paints the unread count into it -
// has a different fingerprint every time, but the colour of the badge stays
// put. Counting pixels of that colour recognises the state whatever the number.
static bool MatchesColors(const std::vector<ColorCondition>& wanted,
                          const IconSummary* seen) {
    if (wanted.empty()) {
        return true;
    }
    if (!seen) {
        return false;
    }

    for (const ColorCondition& want : wanted) {
        uint32_t found = 0;
        for (const PaletteEntry& entry : seen->palette) {
            int r = (int)((entry.rgb >> 16) & 0xFF);
            int g = (int)((entry.rgb >> 8) & 0xFF);
            int b = (int)(entry.rgb & 0xFF);
            if (abs(r - want.r) <= want.tolerance &&
                abs(g - want.g) <= want.tolerance &&
                abs(b - want.b) <= want.tolerance) {
                found += entry.count;
            }
        }
        if (found >= (uint32_t)want.minPixels) {
            return true;  // any listed colour is enough
        }
    }
    return false;
}

// Call with the state lock held. The first rule that fits wins, so a rule
// naming a state must come before the catch-all one.
static const LocalRule* FindLocalRule(const MatchContext& context) {
    for (const LocalRule& rule : g_localRules) {
        if (!MatchesText(rule.windowClass, context.className) ||
            !MatchesText(rule.windowTitle, context.title) ||
            !MatchesText(rule.trayTooltip, context.tooltip) ||
            !MatchesOriginal(rule.originalHashes, context.original) ||
            !MatchesColors(rule.originalColors, context.original)) {
            continue;
        }
        return &rule;
    }
    return nullptr;
}

static HICON PickIcon(const LocalRule* rule, bool big) {
    if (!rule) {
        return nullptr;
    }
    HICON result = big ? rule->hBig : rule->hSmall;
    if (!result) {
        result = big ? rule->hSmall : rule->hBig;
    }
    return result;
}

// The icon this window should show, or NULL. `original` is what the program
// itself answers with - the state it is in. The returned handle stays owned by
// the mod and is never destroyed before unload.
static HICON IconForWindow(HWND hWnd, bool big, HICON original,
                           bool remember = false) {
    WindowInfo info;
    GetWindowInfo(hWnd, &info);

    MatchContext context;
    context.className = info.valid ? info.className : nullptr;
    context.title = info.valid ? info.title : nullptr;

    IconSummary summary;
    if (original && (g_needOriginal.load(std::memory_order_relaxed) ||
                     g_optCapture.load(std::memory_order_relaxed)) &&
        SummariseIcon(original, &summary)) {
        context.original = &summary;
        CaptureIcon(original, summary.hash, L"window",
                    info.valid ? info.title : nullptr);
        if (remember) {
            AcquireSRWLockExclusive(&g_stateLock);
            g_windowState[hWnd].state = summary.hash;
            ReleaseSRWLockExclusive(&g_stateLock);
        }
    } else if (!remember && g_needOriginal.load(std::memory_order_relaxed)) {
        // our own icon is in the window by now, so the state comes from what
        // the program set the last time it changed it
        uint64_t remembered = 0;
        AcquireSRWLockShared(&g_stateLock);
        auto it = g_windowState.find(hWnd);
        if (it != g_windowState.end()) {
            remembered = it->second.state;
        }
        ReleaseSRWLockShared(&g_stateLock);
        if (remembered) {
            summary.hash = remembered;
            context.original = &summary;
        }
    }

    AcquireSRWLockShared(&g_stateLock);
    HICON result = PickIcon(FindLocalRule(context), big);
    ReleaseSRWLockShared(&g_stateLock);

    return result;
}

// The tray is matched without the window conditions - a tray icon normally
// belongs to a hidden helper window whose class and title mean nothing - but
// the icon being replaced and the tooltip both carry the state.
static HICON IconForTray(HICON original, PCWSTR tooltip) {
    MatchContext context;
    context.tooltip = tooltip;

    IconSummary summary;
    if (original && (g_needOriginal.load(std::memory_order_relaxed) ||
                     g_optCapture.load(std::memory_order_relaxed)) &&
        SummariseIcon(original, &summary)) {
        context.original = &summary;
        CaptureIcon(original, summary.hash, L"tray", tooltip);
    }

    AcquireSRWLockShared(&g_stateLock);
    HICON result = PickIcon(FindLocalRule(context), false);
    ReleaseSRWLockShared(&g_stateLock);

    return result;
}

// Which rule covers this program, or -1. Call without the lock held. With a
// context, the state conditions are applied as well; without one, only the
// program name is looked at.
// `unconditionalOnly` is for a plain file on disk: it has no state, so a rule
// that names one must not claim it - that is what the catch-all rule is for.
static int RuleIndexForPath(PCWSTR path, const MatchContext* context,
                            bool unconditionalOnly) {
    if (!path || !*path) {
        return -1;
    }

    PCWSTR fileName = FileNamePart(path);
    int matched = -1;

    AcquireSRWLockShared(&g_stateLock);
    for (size_t i = 0; i < g_rules.size(); i++) {
        const Rule& rule = g_rules[i];
        if (!ProcessMatches(rule.processPatterns, path, fileName)) {
            continue;
        }
        if (unconditionalOnly &&
            (!rule.originalHashes.empty() || !rule.originalColors.empty() ||
             !rule.trayTooltip.empty() || !rule.windowClass.empty() ||
             !rule.windowTitle.empty())) {
            continue;
        }
        if (context && (!MatchesText(rule.windowClass, context->className) ||
                        !MatchesText(rule.windowTitle, context->title) ||
                        !MatchesText(rule.trayTooltip, context->tooltip) ||
                        !MatchesOriginal(rule.originalHashes,
                                         context->original) ||
                        !MatchesColors(rule.originalColors,
                                       context->original))) {
            continue;
        }
        matched = (int)i;
        break;
    }
    ReleaseSRWLockShared(&g_stateLock);

    return matched;
}

// A rule's icon at an arbitrary size, loaded once and kept until unload. The
// handle stays owned by the mod.
static HICON IconForRuleIndex(int ruleIndex, int cx, int cy) {
    if (ruleIndex < 0 || cx <= 0 || cy <= 0) {
        return nullptr;
    }

    WCHAR key[64];
    wsprintfW(key, L"%d|%d|%d", ruleIndex, cx, cy);

    HICON hIcon = nullptr;
    bool cached = false;

    AcquireSRWLockShared(&g_stateLock);
    auto it = g_fileIconCache.find(key);
    if (it != g_fileIconCache.end()) {
        hIcon = it->second;
        cached = true;
    }
    ReleaseSRWLockShared(&g_stateLock);

    if (cached) {
        return hIcon;
    }

    AcquireSRWLockExclusive(&g_stateLock);
    auto existing = g_fileIconCache.find(key);
    if (existing != g_fileIconCache.end()) {
        hIcon = existing->second;
    } else if (ruleIndex < (int)g_rules.size()) {
        hIcon = LoadIconAtSize(g_rules[ruleIndex].icon, cx, cy);
        g_fileIconCache[key] = hIcon;  // a failure is cached as NULL
        if (hIcon) {
            g_ownedIcons.push_back(hIcon);
        }
    }
    ReleaseSRWLockExclusive(&g_stateLock);

    return hIcon;
}

// The icon for a file path, for the extraction hooks. Returns a copy which the
// caller owns, matching the API contract.
static HICON IconForFile(PCWSTR path, int cx, int cy) {
    if (!path || !*path || cx <= 0 || cy <= 0 || g_inIconLoad) {
        return nullptr;
    }

    // The common case - a file no rule mentions - costs a shared lock and a
    // name comparison, nothing more: SHGetFileInfoW is a hot path.
    int ruleIndex = RuleIndexForPath(path, nullptr, true);
    if (ruleIndex < 0) {
        return nullptr;
    }

    HICON hIcon = IconForRuleIndex(ruleIndex, cx, cy);
    return hIcon ? CopyIcon(hIcon) : nullptr;
}

// The program behind a window in another process.
static bool PathOfWindowProcess(HWND hWnd, DWORD processId,
                                std::wstring* exePath) {
    HANDLE process =
        OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, processId);
    if (!process) {
        return false;
    }

    WCHAR path[MAX_PATH] = L"";
    DWORD size = ARRAYSIZE(path);
    BOOL ok = QueryFullProcessImageNameW(process, 0, path, &size);
    CloseHandle(process);

    if (ok) {
        *exePath = path;
    }
    return ok;
}

// The icon to hand to a program asking another process's window for its icon.
// A fresh handle every time, because ManagedShell destroys an icon handle it
// recognises from the previous query.
static HICON IconForRemoteWindow(HWND hWnd, bool big, HICON original) {
    if (!hWnd) {
        return nullptr;
    }

    DWORD processId = 0;
    GetWindowThreadProcessId(hWnd, &processId);
    if (!processId || processId == GetCurrentProcessId()) {
        return nullptr;
    }

    std::wstring exePath;
    bool anyRule = false;
    bool known = false;

    AcquireSRWLockShared(&g_stateLock);
    auto it = g_remoteWindows.find(hWnd);
    if (it != g_remoteWindows.end() && it->second.processId == processId) {
        exePath = it->second.exePath;
        anyRule = it->second.anyRule;
        known = true;
    }
    ReleaseSRWLockShared(&g_stateLock);

    if (!known) {
        if (PathOfWindowProcess(hWnd, processId, &exePath)) {
            anyRule = RuleIndexForPath(exePath.c_str(), nullptr, false) >= 0;
        }

        AcquireSRWLockExclusive(&g_stateLock);
        if (g_remoteWindows.size() > 512) {
            for (auto& [staleWnd, stale] : g_remoteWindows) {
                if (stale.hSmallInFlight) {
                    g_ownedIcons.push_back(stale.hSmallInFlight);
                }
                if (stale.hBigInFlight) {
                    g_ownedIcons.push_back(stale.hBigInFlight);
                }
            }
            g_remoteWindows.clear();
        }
        RemoteWindow& entry = g_remoteWindows[hWnd];
        entry.processId = processId;
        entry.exePath = exePath;
        entry.anyRule = anyRule;
        ReleaseSRWLockExclusive(&g_stateLock);
    }

    if (!anyRule) {
        return nullptr;
    }

    // The rule is picked afresh on every request: the program may have changed
    // state since the last one.
    WindowInfo info;
    GetWindowInfo(hWnd, &info);

    MatchContext context;
    context.className = info.valid ? info.className : nullptr;
    context.title = info.valid ? info.title : nullptr;
    IconSummary summary;
    if (original && (g_needOriginal.load(std::memory_order_relaxed) ||
                     g_optCapture.load(std::memory_order_relaxed)) &&
        SummariseIcon(original, &summary)) {
        context.original = &summary;
        CaptureIcon(original, summary.hash, L"remote",
                    info.valid ? info.title : nullptr);
    }

    int ruleIndex = RuleIndexForPath(exePath.c_str(), &context, false);
    if (ruleIndex < 0) {
        return nullptr;
    }

    HICON master = IconForRuleIndex(
        ruleIndex, GetSystemMetrics(big ? SM_CXICON : SM_CXSMICON),
        GetSystemMetrics(big ? SM_CYICON : SM_CYSMICON));
    if (!master) {
        return nullptr;
    }

    HICON copy = CopyIcon(master);
    if (!copy) {
        return nullptr;
    }

    HICON previous = nullptr;
    AcquireSRWLockExclusive(&g_stateLock);
    RemoteWindow& entry = g_remoteWindows[hWnd];
    entry.processId = processId;
    entry.exePath = exePath;
    entry.anyRule = true;
    HICON& inFlight = big ? entry.hBigInFlight : entry.hSmallInFlight;
    previous = inFlight;
    inFlight = copy;
    ReleaseSRWLockExclusive(&g_stateLock);

    // The previous handle was read and converted during the earlier call.
    if (previous) {
        DestroyIcon(previous);
    }

    return copy;
}

// ---------------------------------------------------------------------------
// Hooks: window icons
// ---------------------------------------------------------------------------

// Leaves a mark on the window saying the replacement happens in here, so the
// hook on the taskbar side does not answer over the top of it with a state it
// cannot see.
static void MarkWindowHandled(HWND hWnd) {
    bool known = false;
    AcquireSRWLockShared(&g_stateLock);
    known = g_markedWindows.find(hWnd) != g_markedWindows.end();
    ReleaseSRWLockShared(&g_stateLock);
    if (known) {
        return;
    }

    SetPropW(hWnd, kHandledProp, (HANDLE)1);

    AcquireSRWLockExclusive(&g_stateLock);
    if (g_markedWindows.size() < 512) {
        g_markedWindows[hWnd] = true;
    }
    ReleaseSRWLockExclusive(&g_stateLock);
}

// The program answers first: its own icon is the only evidence of which state
// it is in.
// The program setting its own icon is the one moment when both things are at
// hand: the state it is in, and the chance to put our icon where the caption
// reads it from. A copy is handed over and the previous one released, because
// whoever calls WM_SETICON owns the icon it passes.
static bool SubstituteSetIcon(HWND hWnd, WPARAM which, LPARAM* lParam) {
    if (!g_activeHere.load(std::memory_order_relaxed) ||
        !g_optWindows.load(std::memory_order_relaxed) || g_inPush) {
        return false;
    }

    bool big = (which == ICON_BIG);
    HICON ours = IconForWindow(hWnd, big, (HICON)*lParam, true);
    if (!ours) {
        return false;
    }

    HICON copy = CopyIcon(ours);
    if (!copy) {
        return false;
    }

    HICON previous = nullptr;
    AcquireSRWLockExclusive(&g_stateLock);
    WindowIcons& entry = g_windowState[hWnd];
    HICON& slot = big ? entry.ourBigCopy : entry.ourSmallCopy;
    previous = slot;
    slot = copy;
    ReleaseSRWLockExclusive(&g_stateLock);
    if (previous) {
        DestroyIcon(previous);
    }

    *lParam = (LPARAM)copy;
    return true;
}

#define DEFINE_DEFPROC_HOOK(name)                                            \
    using name##_t = decltype(&name);                                        \
    static name##_t name##_orig;                                             \
    static LRESULT WINAPI name##_hook(HWND hWnd, UINT uMsg, WPARAM wParam,   \
                                      LPARAM lParam) {                       \
        if (uMsg == WM_SETICON) {                                            \
            MarkWindowHandled(hWnd);                                         \
            SubstituteSetIcon(hWnd, wParam, &lParam);                        \
        }                                                                    \
        LRESULT result = name##_orig(hWnd, uMsg, wParam, lParam);            \
        if (uMsg == WM_GETICON &&                                            \
            g_activeHere.load(std::memory_order_relaxed) &&                  \
            g_optWindows.load(std::memory_order_relaxed)) {                  \
            MarkWindowHandled(hWnd);                                         \
            HICON replacement =                                              \
                IconForWindow(hWnd, wParam == ICON_BIG, (HICON)result);      \
            if (replacement) {                                               \
                return (LRESULT)replacement;                                 \
            }                                                                \
        }                                                                    \
        return result;                                                       \
    }

DEFINE_DEFPROC_HOOK(DefWindowProcW)
DEFINE_DEFPROC_HOOK(DefWindowProcA)
DEFINE_DEFPROC_HOOK(DefDlgProcW)
DEFINE_DEFPROC_HOOK(DefDlgProcA)

