// What is known about an icon the mod is about to replace: the exact
// fingerprint, and how much of each colour it contains. The colours are what
// survives a program redrawing its icon with a different number in it.
struct IconSummary {
    uint64_t hash = 0;
    std::vector<PaletteEntry> palette;
};

